// Arc for macOS' forward arrow: 13 pt long with a 10.5 pt head, 1.5 pt
// strokes, in the same box as the back arrow's.
CANVAS_DIMENSIONS, 22,
STROKE, 1.5f,
MOVE_TO, 11.5f, 6.4f,
LINE_TO, 16.2f, 10.75f,
LINE_TO, 11.5f, 15.1f,
MOVE_TO, 16.2f, 10.75f,
LINE_TO, 5.25f, 10.75f
