<?xml version="1.0" encoding="utf-8"?>
<!-- Arcomium's strings (included from generated_resources.grd). -->
<grit-part>
  <if expr="not is_android">
    <!-- Sidebar -->
    <message name="IDS_ARCOMIUM_NEW_TAB" desc="The sidebar row that opens the command bar for a new tab.">
      New Tab
    </message>
    <message name="IDS_ARCOMIUM_CLOSE_TAB" desc="Tooltip and menu item: close the tab of a sidebar row.">
      Close tab
    </message>
    <message name="IDS_ARCOMIUM_COPY_LINK" desc="Tooltip and menu item: copy the address of a page or a pinned tab.">
      Copy Link
    </message>
    <message name="IDS_ARCOMIUM_DUPLICATE" desc="Sidebar menu item: open a copy of a tab or a pinned tab.">
      Duplicate
    </message>
    <message name="IDS_ARCOMIUM_MUTE_TAB" desc="Sidebar menu item: silence the tab of a row.">
      Mute
    </message>
    <message name="IDS_ARCOMIUM_UNMUTE_TAB" desc="Sidebar menu item: let the muted tab of a row play sound again.">
      Unmute
    </message>
    <message name="IDS_ARCOMIUM_OPEN_IN_SPLIT_VIEW" desc="Sidebar menu item: show the row's tab side by side with the current tab.">
      Open in Split View
    </message>
    <message name="IDS_ARCOMIUM_EDIT_PINNED_PAGE" desc="Sidebar submenu: changes to a pinned tab's saved page.">
      Edit Pinned Page
    </message>
    <message name="IDS_ARCOMIUM_REPLACE_PINNED_URL" desc="Sidebar menu item: make the page the pinned tab now shows its saved page.">
      Save Current Page as Pinned Page
    </message>
    <message name="IDS_ARCOMIUM_EDIT_PINNED_ITEM" desc="Sidebar menu item: edit a pinned tab's name and address in a dialog.">
      Edit Name and Address...
    </message>
    <message name="IDS_ARCOMIUM_MENU_CHECK_UPDATES" desc="Menu of the sidebar logo: open the page of the latest release.">
      Check for Updates
    </message>
    <message name="IDS_ARCOMIUM_MENU_UPDATE_TO" desc="Top item of the sidebar logo's menu and the app menu when a newer Arcomium release is out: open that release's page to download it. $1 is its version.">
      Update to Arcomium <ph name="VERSION">$1<ex>0.1.5</ex></ph>
    </message>
    <message name="IDS_ARCOMIUM_MENU_IMPORT" desc="Menu of the sidebar logo and the app menu: open the page that imports bookmarks and Spaces from other browsers on this computer.">
      Import from Another Browser...
    </message>
    <!-- chrome://arcomium-import -->
    <message name="IDS_ARCOMIUM_IMPORT_TITLE" desc="Title of the page that imports bookmarks and Spaces from other browsers.">
      Import from another browser
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_LEDE" desc="Introduction of the import page.">
      Bring over bookmarks, pinned tabs and Spaces from the browsers on this computer. Arcomium only reads their files: nothing changes in those browsers.
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_SEARCHING" desc="Import page: shown while it looks for other browsers.">
      Looking for browsers on this computer...
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_NOTHING_FOUND" desc="Import page: no browser to import from was found.">
      No other browser with bookmarks was found on this computer. You can still import from a bookmarks file below.
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_REPLACES" desc="Import page: what importing the same browser twice does.">
      Importing a browser again replaces what came from it last time, so nothing is doubled.
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_OTHER_LINK" desc="Import page: link to the standard importer for browsers this page does not read.">
      Firefox, Safari or a bookmarks file
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_OTHER_HINT" desc="Import page: explains the link to the standard importer.">
      Opens the standard importer, which also reads HTML bookmark files.
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_ARC_SUMMARY" desc="Import page: what Arc has. $1 is a number of Spaces, $2 a number of pinned tabs.">
      Spaces: <ph name="SPACE_COUNT">$1<ex>3</ex></ph>, pinned tabs: <ph name="TAB_COUNT">$2<ex>40</ex></ph>
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_ARC_HINT" desc="Import page: where Arc's Spaces go.">
      Every Arc Space becomes a Space here, with its pinned tabs, folders and icons. The first one goes to Home.
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_BOOKMARKS_SUMMARY" desc="Import page: how many bookmarks a browser profile has. $1 is the number.">
      Bookmarks: <ph name="BOOKMARK_COUNT">$1<ex>90</ex></ph>
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_BOOKMARKS_HINT" desc="Import page: where a browser's bookmarks go.">
      They go to a folder pinned in the current Space.
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_BUTTON" desc="Import page: button that imports from one browser.">
      Import
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_AGAIN_BUTTON" desc="Import page: button that imports from a browser once more.">
      Import again
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_WORKING" desc="Import page: shown on the button while importing.">
      Importing...
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_ARC_DONE" desc="Import page: result of importing Arc. $1 is a number of Spaces, $2 of pinned tabs, $3 of folders.">
      Imported. Spaces: <ph name="SPACE_COUNT">$1<ex>3</ex></ph>, pinned tabs: <ph name="TAB_COUNT">$2<ex>40</ex></ph>, folders: <ph name="FOLDER_COUNT">$3<ex>5</ex></ph>.
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_SPACES_CREATED" desc="Import page: how many Spaces importing Arc added to the Space bar. $1 is the number.">
      New Spaces in the Space bar: <ph name="SPACE_COUNT">$1<ex>2</ex></ph>.
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_SPACES_PENDING" desc="Import page: Spaces of Arc that could not be opened here; the user adds them with the plus button of the Space bar. $1 is the number.">
      Click + in the Space bar to add the other Spaces (<ph name="SPACE_COUNT">$1<ex>2</ex></ph>).
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_BOOKMARKS_DONE" desc="Import page: result of importing a browser's bookmarks. $1 is the number of bookmarks, $2 the name of the folder they went to.">
      Imported <ph name="BOOKMARK_COUNT">$1<ex>90</ex></ph> bookmarks into the folder "<ph name="FOLDER_NAME">$2<ex>Google Chrome</ex></ph>".
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_ERROR_BUSY" desc="Import page: another import has not finished yet.">
      Another import is still running. Wait for it to finish.
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_ERROR_NOT_READY" desc="Import page: the bookmarks of this profile have not loaded yet.">
      Bookmarks are still loading. Try again in a moment.
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_ERROR_READ" desc="Import page: the files of the other browser could not be read.">
      Could not read this browser's data. Try again, or close that browser first.
    </message>
    <message name="IDS_ARCOMIUM_IMPORT_ERROR_UNKNOWN" desc="Import page: the browser to import from is gone.">
      This browser is no longer found. Reload the page.
    </message>
    <message name="IDS_ARCOMIUM_MENU_NEW_WINDOW" desc="Menu of the sidebar logo: open a new window.">
      New Window
    </message>
    <message name="IDS_ARCOMIUM_MENU_NEW_INCOGNITO" desc="Menu of the sidebar logo: open a new incognito window.">
      New Incognito Window
    </message>
    <message name="IDS_ARCOMIUM_MENU_SPACES" desc="Menu of the sidebar logo: submenu of the Space commands.">
      Spaces
    </message>
    <message name="IDS_ARCOMIUM_MENU_NEXT_SPACE" desc="Menu of the sidebar logo: show the Space after this one.">
      Next Space
    </message>
    <message name="IDS_ARCOMIUM_MENU_PREVIOUS_SPACE" desc="Menu of the sidebar logo: show the Space before this one.">
      Previous Space
    </message>
    <message name="IDS_ARCOMIUM_MENU_TABS" desc="Menu of the sidebar logo: submenu of the tab commands.">
      Tabs
    </message>
    <message name="IDS_ARCOMIUM_MENU_COMMAND_BAR" desc="Menu of the sidebar logo: open the command bar to search or type an address.">
      Open Command Bar
    </message>
    <message name="IDS_ARCOMIUM_MENU_PIN_TAB" desc="macOS menu bar, Tabs menu: pin the shown tab in the current Space, as Arc's Pin Tab.">
      Pin Tab
    </message>
    <message name="IDS_ARCOMIUM_MENU_CLEAR_TODAY" desc="macOS menu bar, Tabs menu: close the current Space's tabs that are not pinned, as Arc's Clear Today.">
      Clear Today
    </message>
    <message name="IDS_ARCOMIUM_MENU_EDIT_THEME" desc="macOS menu bar, Spaces menu: open the current Space's theme color picker.">
      Edit Theme…
    </message>
    <message name="IDS_ARCOMIUM_MENU_OPEN_COMMAND_BAR" desc="macOS menu bar, File menu: open the command bar, where an address or a search is typed.">
      Open Command Bar
    </message>
    <message name="IDS_ARCOMIUM_MENU_NEXT_TAB" desc="Menu of the sidebar logo: select the next tab.">
      Next Tab
    </message>
    <message name="IDS_ARCOMIUM_MENU_PREVIOUS_TAB" desc="Menu of the sidebar logo: select the previous tab.">
      Previous Tab
    </message>
    <message name="IDS_ARCOMIUM_MENU_REOPEN_TAB" desc="Menu of the sidebar logo: reopen the tab closed last.">
      Reopen Closed Tab
    </message>
    <message name="IDS_ARCOMIUM_MENU_HISTORY" desc="Menu of the sidebar logo: open the history.">
      History
    </message>
    <message name="IDS_ARCOMIUM_MENU_BOOKMARKS" desc="Menu of the sidebar logo: open the bookmark manager.">
      Bookmarks
    </message>
    <message name="IDS_ARCOMIUM_MENU_DEVELOPER" desc="Menu of the sidebar logo: submenu of the developer tools.">
      Developer
    </message>
    <message name="IDS_ARCOMIUM_MENU_VIEW_SOURCE" desc="Menu of the sidebar logo: show the page source.">
      View Page Source
    </message>
    <message name="IDS_ARCOMIUM_MENU_DEV_TOOLS" desc="Menu of the sidebar logo: open the developer tools.">
      Developer Tools
    </message>
    <message name="IDS_ARCOMIUM_MENU_INSPECT" desc="Menu of the sidebar logo: open the developer tools on the elements panel.">
      Inspect Elements
    </message>
    <message name="IDS_ARCOMIUM_MENU_CONSOLE" desc="Menu of the sidebar logo: open the developer tools on the console.">
      JavaScript Console
    </message>
    <message name="IDS_ARCOMIUM_MENU_TASK_MANAGER" desc="Menu of the sidebar logo: open the task manager.">
      Task Manager
    </message>
    <message name="IDS_ARCOMIUM_MENU_SYNC" desc="Menu of the sidebar logo: open the sync settings.">
      Sync
    </message>
    <message name="IDS_ARCOMIUM_MENU_SETTINGS" desc="Menu of the sidebar logo: open the settings.">
      Settings
    </message>
    <message name="IDS_ARCOMIUM_MENU_PRINT" desc="Menu of the sidebar logo: print the page.">
      Print...
    </message>
    <message name="IDS_ARCOMIUM_MENU_ABOUT" desc="Menu of the sidebar logo: show the version and the about page.">
      About Arcomium
    </message>
    <message name="IDS_ARCOMIUM_MENU_CLOSE_WINDOW" desc="Menu of the sidebar logo: close this window.">
      Close Window
    </message>
    <message name="IDS_ARCOMIUM_RENAME" desc="Sidebar menu item: rename a folder or a pinned tab.">
      Rename…
    </message>
    <message name="IDS_ARCOMIUM_MOVE_TO" desc="Sidebar menu: the submenu that moves a tab to another Space.">
      Move to
    </message>
    <message name="IDS_ARCOMIUM_PIN_CURRENT_TAB_HERE" desc="Sidebar folder menu item: pin the shown tab into this folder.">
      Pin current tab here
    </message>
    <message name="IDS_ARCOMIUM_NEW_FOLDER_INSIDE" desc="Sidebar folder menu item: create a folder inside this one.">
      New Nested Folder…
    </message>
    <message name="IDS_ARCOMIUM_DELETE_FOLDER" desc="Sidebar folder menu item: delete the folder and its pinned tabs.">
      Delete
    </message>
    <message name="IDS_ARCOMIUM_UNPIN" desc="Sidebar menu item: unpin a pinned tab.">
      Remove Pin
    </message>
    <message name="IDS_ARCOMIUM_PIN_TO_SPACE" desc="Sidebar tab menu item: pin the tab to the current Space.">
      Pin to this Space
    </message>
    <message name="IDS_ARCOMIUM_NEW_FOLDER" desc="Sidebar menu item: create a folder of pinned tabs.">
      New Folder
    </message>
    <message name="IDS_ARCOMIUM_TURN_INTO_SPACE" desc="Sidebar folder menu item: make the folder a new Space of its own, its items the Space's pinned tabs. $1 is the folder's name.">
      Turn “<ph name="FOLDER_NAME">$1<ex>Shopping</ex></ph>” into Space
    </message>
    <message name="IDS_ARCOMIUM_COPY_ALL_LINKS" desc="Sidebar folder menu item: copy the addresses of the folder's pinned tabs, one per line.">
      Copy All Links
    </message>
    <message name="IDS_ARCOMIUM_ADD_TO_FAVORITES" desc="Sidebar menu item: add a tab or a pinned tab to the favorites, the tiles above every Space.">
      Add to Favorites
    </message>
    <message name="IDS_ARCOMIUM_REMOVE_FAVORITE" desc="Favorite tile menu item: remove the favorite.">
      Remove Favorite
    </message>
    <message name="IDS_ARCOMIUM_FAVORITES" desc="Name of the bookmark folder that holds the favorites tiles.">
      Favorites
    </message>
    <message name="IDS_ARCOMIUM_RENAME_SPACE" desc="Space menu item: rename the Space.">
      Rename Space…
    </message>
    <message name="IDS_ARCOMIUM_COLLAPSE_PINNED" desc="Tooltip of the chevron on the Space's name: hide the Space's pinned tabs.">
      Collapse Pinned Tabs
    </message>
    <message name="IDS_ARCOMIUM_EXPAND_PINNED" desc="Tooltip of the chevron on the Space's name: show the Space's pinned tabs again.">
      Expand Pinned Tabs
    </message>
    <message name="IDS_ARCOMIUM_SPACE_OPTIONS" desc="Tooltip of the button on the Space's name that opens the Space's menu.">
      Space Options
    </message>
    <message name="IDS_ARCOMIUM_MENU_HIDE_SIDEBAR" desc="macOS View menu item, Command-S: hides the sidebar, which then floats over the page while the pointer is at the window's left edge.">
      Hide Sidebar
    </message>
    <message name="IDS_ARCOMIUM_MENU_SHOW_SIDEBAR" desc="macOS View menu item, Command-S, while the sidebar is hidden: shows it again.">
      Show Sidebar
    </message>
    <message name="IDS_ARCOMIUM_MENU_COPY_URL" desc="macOS Edit menu item, Shift-Command-C: copies the current page's address.">
      Copy URL
    </message>
    <message name="IDS_ARCOMIUM_GO_BACK" desc="Tooltip of the sidebar's back button on macOS, shown with its shortcut.">
      Go back
    </message>
    <message name="IDS_ARCOMIUM_GO_FORWARD" desc="Tooltip of the sidebar's forward button on macOS, shown with its shortcut.">
      Go forward
    </message>
    <message name="IDS_ARCOMIUM_MORE_OPTIONS" desc="Tooltip of the sidebar's '...' button on macOS, which opens a menu with Reload and Hide Sidebar.">
      More options
    </message>
    <message name="IDS_ARCOMIUM_DOUBLE_CLICK_TO_RENAME" desc="Second line of a pinned tab's tooltip in the sidebar: double-clicking the row renames it.">
      Double-click to rename
    </message>
    <message name="IDS_ARCOMIUM_SWITCH_TO_TAB" desc="Button at the end of an open tab's row in the command bar: switch to that tab.">
      Switch to Tab
    </message>
    <message name="IDS_ARCOMIUM_SEARCH_FOLDER" desc="Placeholder of the search field in a sidebar folder's popup, which filters the folder's links.">
      Search <ph name="FOLDER">$1<ex>Shopping</ex></ph>...
    </message>
    <message name="IDS_ARCOMIUM_EDIT_THEME_COLOR" desc="Menu item: pick the color of the current Space.">
      Edit Theme Color…
    </message>

    <!-- Spaces -->
    <message name="IDS_ARCOMIUM_ARCHIVE" desc="Tooltip of the button that opens the history, which Arc calls the archive.">
      Archive
    </message>
    <message name="IDS_ARCOMIUM_NEW_SPACE" desc="Tooltip of the button that creates a Space, a set of tabs with its own pinned tabs.">
      New Space
    </message>
    <message name="IDS_ARCOMIUM_SPACE_ICON" desc="Space menu: the submenu that picks the Space's icon.">
      Change Space Icon
    </message>
    <message name="IDS_ARCOMIUM_DELETE_SPACE" desc="Space menu item: delete the Space after asking.">
      Delete Space…
    </message>
    <message name="IDS_ARCOMIUM_DELETE_SPACE_TITLE" desc="Title of the question asked before deleting a Space.">
      Delete Space?
    </message>
    <message name="IDS_ARCOMIUM_DELETE_SPACE_BODY" desc="Question asked before deleting a Space. The placeholder is the Space's name in quotes.">
      “<ph name="SPACE_NAME">$1<ex>Work</ex></ph>”, its tabs and its pinned tabs will be deleted on all your devices.
    </message>
    <message name="IDS_ARCOMIUM_DELETE_UNNAMED_SPACE_BODY" desc="Question asked before deleting a Space that has no name.">
      This Space, its tabs and its pinned tabs will be deleted on all your devices.
    </message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_SUN" desc="A Space icon: a sun.">Sun</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_BOOK" desc="A Space icon: a book.">Book</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_HOME" desc="A Space icon: a house.">Home</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_CODE" desc="A Space icon: angle brackets for code.">Code</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_GLOBE" desc="A Space icon: a globe.">Globe</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_BOLT" desc="A Space icon: a lightning bolt.">Bolt</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_STAR" desc="A Space icon: a star.">Star</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_CHAT" desc="A Space icon: a speech bubble.">Chat</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_MAIL" desc="A Space icon: an envelope.">Mail</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_IDEA" desc="A Space icon: a light bulb.">Idea</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_ROCKET" desc="A Space icon: a rocket.">Rocket</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_PETS" desc="A Space icon: a paw.">Pets</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_TRAVEL" desc="A Space icon: a plane.">Travel</message>
    <message name="IDS_ARCOMIUM_SPACE_ICON_DOT" desc="A Space icon: a dot.">Dot</message>

    <!-- Mini player -->
    <message name="IDS_ARCOMIUM_PLAY" desc="Tooltip of the mini player's button while the media is paused.">
      Play
    </message>
    <message name="IDS_ARCOMIUM_PAUSE" desc="Tooltip of the mini player's button while the media plays.">
      Pause
    </message>

    <!-- Site controls -->
    <message name="IDS_ARCOMIUM_SITE_CONTROLS" desc="Name of the panel of a site's actions, extensions and permissions, and of the button that opens it.">
      Site Controls
    </message>
    <message name="IDS_ARCOMIUM_FIND_IN_PAGE" desc="Site controls button: find text in the page.">
      Find in Page
    </message>
    <message name="IDS_ARCOMIUM_SCREENSHOT" desc="Site controls button: capture a region of the page.">
      Screenshot
    </message>
    <message name="IDS_ARCOMIUM_READING_MODE" desc="Site controls button: show the page in reading mode.">
      Reading Mode
    </message>
    <message name="IDS_ARCOMIUM_EXTENSIONS" desc="Site controls heading over the extensions.">
      Extensions
    </message>
    <message name="IDS_ARCOMIUM_SITE_PERMISSIONS" desc="Site controls heading over the site's permissions.">
      Settings
    </message>
    <message name="IDS_ARCOMIUM_SECURE" desc="Site controls: the connection to the site is secure.">
      Secure
    </message>
    <message name="IDS_ARCOMIUM_NOT_SECURE" desc="Site controls: the connection to the site is not secure.">
      Not Secure
    </message>
    <message name="IDS_ARCOMIUM_MORE" desc="Tooltip of the site controls button that opens more options.">
      More
    </message>
    <message name="IDS_ARCOMIUM_SITE_SETTINGS" desc="Site controls menu item: open the site's settings page.">
      Site Settings
    </message>
    <message name="IDS_ARCOMIUM_EXTENSION_SITE_ACCESS" desc="Site controls menu item: open Chrome's extensions menu, where extensions' access to the site is set.">
      Extension Site Access
    </message>
    <message name="IDS_ARCOMIUM_MANAGE_EXTENSIONS" desc="Site controls tile and menu item: open the extensions page.">
      Manage Extensions
    </message>
    <!-- Arcomium's changes to Chromium's views -->
    <message name="IDS_ARCOMIUM_ADD_TO_ARCOMIUM" desc="App menu item on a Chrome Web Store page: install its extension.">
      Add to Arcomium
    </message>
    <message name="IDS_ARCOMIUM_SITE_SETTINGS_TOOLTIP" desc="Tooltip of the address bar button that opens the site's settings.">
      Site settings
    </message>
    <message name="IDS_ARCOMIUM_ADDRESS_PLACEHOLDER" desc="Placeholder of the address bar when it is empty.">
      Search or Enter URL...
    </message>
    <message name="IDS_ARCOMIUM_SIDEBAR_PLACEHOLDER" desc="Placeholder of the sidebar's address field when it is empty.">
      Search...
    </message>
    <message name="IDS_ARCOMIUM_SPLIT_VIEW" desc="Tooltip of the button that shows two tabs side by side.">
      Split view
    </message>
    <message name="IDS_ARCOMIUM_BACK" desc="Tooltip of the sidebar's back button.">
      Back
    </message>
    <message name="IDS_ARCOMIUM_FORWARD" desc="Tooltip of the sidebar's forward button.">
      Forward
    </message>
    <message name="IDS_ARCOMIUM_RELOAD" desc="Tooltip of the sidebar's reload button.">
      Reload
    </message>
    <message name="IDS_ARCOMIUM_SEARCH_ENGINE" desc="App menu item: pick the address bar's search engine or add one.">
      Search Engine
    </message>
    <message name="IDS_ARCOMIUM_MENU" desc="Tooltip of the sidebar button that opens Arcomium's menu.">
      Arcomium menu
    </message>
    <message name="IDS_ARCOMIUM_HIDE_SIDEBAR" desc="Tooltip of the button that hides the sidebar.">
      Hide sidebar
    </message>
    <message name="IDS_ARCOMIUM_DOWNLOADS" desc="Tooltip of the sidebar button that shows downloads.">
      Downloads
    </message>
    <message name="IDS_ARCOMIUM_TOGGLE_SIDEBAR" desc="macOS: item of the sidebar header's More popover that hides or shows the sidebar.">
      Toggle Sidebar
    </message>
    <message name="IDS_ARCOMIUM_NEW_SPLIT" desc="macOS: item of the Space bar's plus popover that splits the current tab with a new one.">
      New Split
    </message>
    <message name="IDS_ARCOMIUM_CHANGE_SPACE_ICON" desc="macOS: Space menu item that opens the icon picker for the Space.">
      Change Space Icon…
    </message>
    <message name="IDS_ARCOMIUM_DELETE_SPACE_MAC" desc="macOS: Space menu item: delete the Space after asking.">
      Delete Space
    </message>
    <message name="IDS_ARCOMIUM_CHANGE_ICON" desc="macOS: sidebar menu item that opens the icon picker for a pinned tab, favorite or folder.">
      Change Icon…
    </message>
  </if>
</grit-part>
