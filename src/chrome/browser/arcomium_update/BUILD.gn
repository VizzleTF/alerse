import("//build/util/process_version.gni")

# arcomium_version.h: the Arcomium release this build is, from chrome/VERSION's
# ARCOMIUM_VERSION (tools/rename_product.py writes it); empty without it.
process_version("version_header") {
  template_file = "arcomium_version.h.in"
  sources = [ "//chrome/VERSION" ]
  output = "$target_gen_dir/arcomium_version.h"
  extra_args = [
    "-e",
    "ARCOMIUM_VERSION=locals().get('ARCOMIUM_VERSION',str())",
  ]
}

source_set("arcomium_update") {
  sources = [
    "arcomium_update_checker.cc",
    "arcomium_update_checker.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser:main_extra_parts",
    "//url",
  ]
  deps = [
    ":version_header",
    "//chrome/browser:browser_process",
    "//chrome/browser/headless",
    "//chrome/common:non_code_constants",
    "//components/prefs",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
  ]
  if (is_win) {
    # Removes Arcomium once Alerse took over its profile.
    sources += [
      "arcomium_legacy_install_win.cc",
      "arcomium_legacy_install_win.h",
    ]
    deps += [ "//chrome/common:constants" ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "arcomium_update_checker_unittest.cc" ]
  deps = [
    ":arcomium_update",
    ":version_header",
    "//base",
    "//components/prefs:test_support",
    "//testing/gtest",
    "//url",
  ]
  if (is_win) {
    sources += [ "arcomium_legacy_install_win_unittest.cc" ]
  }
}
