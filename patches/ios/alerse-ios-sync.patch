+// Copyright 2026 The Alerse Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/chrome/browser/webui/ui_bundled/alerse_sync_ui.h"
+
+#import <memory>
+#import <optional>
+#import <string>
+#import <utility>
+
+#import "base/functional/bind.h"
+#import "base/memory/raw_ptr.h"
+#import "base/memory/scoped_refptr.h"
+#import "base/memory/weak_ptr.h"
+#import "base/scoped_observation.h"
+#import "base/time/time.h"
+#import "base/values.h"
+#import "components/os_crypt/async/browser/os_crypt_async.h"
+#import "components/os_crypt/async/common/encryptor.h"
+#import "components/prefs/pref_service.h"
+#import "components/sync/service/alerse_sync_account.h"
+#import "components/sync/service/sync_service.h"
+#import "components/sync/service/sync_service_impl.h"
+#import "components/sync/service/sync_service_observer.h"
+#import "components/sync/service/sync_user_settings.h"
+#import "google_apis/gaia/google_service_auth_error.h"
+#import "ios/chrome/browser/shared/model/application_context/application_context.h"
+#import "ios/chrome/browser/shared/model/profile/profile_ios.h"
+#import "ios/chrome/browser/shared/model/url/chrome_url_constants.h"
+#import "ios/chrome/browser/sync/model/sync_service_factory.h"
+#import "ios/chrome/grit/ios_resources.h"
+#import "ios/web/public/webui/web_ui_ios.h"
+#import "ios/web/public/webui/web_ui_ios_data_source.h"
+#import "ios/web/public/webui/web_ui_ios_message_handler.h"
+#import "net/traffic_annotation/network_traffic_annotation.h"
+#import "services/network/public/cpp/resource_request.h"
+#import "services/network/public/cpp/shared_url_loader_factory.h"
+#import "services/network/public/cpp/simple_url_loader.h"
+#import "url/gurl.h"
+
+namespace {
+
+constexpr base::TimeDelta kHealthCheckTimeout = base::Seconds(10);
+
+constexpr net::NetworkTrafficAnnotationTag kHealthCheckAnnotation =
+    net::DefineNetworkTrafficAnnotation("alerse_sync_server_check_ios", R"(
+      semantics {
+        sender: "Alerse Sync"
+        description:
+          "Checks that the sync server the user typed answers before the "
+          "browser starts syncing with it."
+        trigger: "The user starts or joins a sync chain."
+        data: "None."
+        destination: OTHER
+        destination_other: "The sync server the user typed."
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Not started unless the user sets up sync."
+        policy_exception_justification: "Not implemented."
+      })");
+
+// Reads a server address as people type it: "https://sync.example.com" means
+// its protocol endpoint, "https://sync.example.com/v2".
+GURL NormalizeServerURL(const std::string& typed) {
+  GURL url(typed);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.host().empty()) {
+    return GURL();
+  }
+  GURL::Replacements clean;
+  clean.ClearQuery();
+  clean.ClearRef();
+  if (url.path() == "/" || url.path().empty()) {
+    clean.SetPathStr("/v2");
+  }
+  return url.ReplaceComponents(clean);
+}
+
+// The JavaScript time of `time`, or 0 for none.
+double ToJsTime(base::Time time) {
+  return time.is_null() ? 0 : time.InMillisecondsFSinceUnixEpoch();
+}
+
+web::WebUIIOSDataSource* CreateHTMLSource() {
+  web::WebUIIOSDataSource* source =
+      web::WebUIIOSDataSource::Create(kChromeUIAlerseSyncHost);
+  source->AddResourcePath("alerse_sync.js", IDR_IOS_ALERSE_SYNC_JS);
+  source->AddResourcePath("alerse_sync.css", IDR_IOS_ALERSE_SYNC_CSS);
+  source->SetDefaultResource(IDR_IOS_ALERSE_SYNC_HTML);
+  return source;
+}
+
+// The page's messages, as AlerseSyncHandler on desktop.
+class AlerseSyncHandler : public web::WebUIIOSMessageHandler,
+                            public syncer::SyncServiceObserver {
+ public:
+  explicit AlerseSyncHandler(ProfileIOS* profile) : profile_(profile) {}
+  AlerseSyncHandler(const AlerseSyncHandler&) = delete;
+  AlerseSyncHandler& operator=(const AlerseSyncHandler&) = delete;
+  ~AlerseSyncHandler() override = default;
+
+  // web::WebUIIOSMessageHandler:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getState", base::BindRepeating(&AlerseSyncHandler::HandleGetState,
+                                        base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "createChain",
+        base::BindRepeating(&AlerseSyncHandler::HandleCreateChain,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "joinChain", base::BindRepeating(&AlerseSyncHandler::HandleJoinChain,
+                                         base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "showCode", base::BindRepeating(&AlerseSyncHandler::HandleShowCode,
+                                        base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "leaveChain",
+        base::BindRepeating(&AlerseSyncHandler::HandleLeaveChain,
+                            base::Unretained(this)));
+    if (syncer::SyncService* sync = GetSyncService()) {
+      sync_observation_.Observe(sync);
+    }
+  }
+
+  // syncer::SyncServiceObserver:
+  void OnStateChanged(syncer::SyncService* sync) override {
+    web_ui()->FireWebUIListener("state-changed", BuildState());
+  }
+  void OnSyncShutdown(syncer::SyncService* sync) override {
+    sync_observation_.Reset();
+  }
+
+ private:
+  syncer::SyncService* GetSyncService() const {
+    return SyncServiceFactory::GetForProfile(profile_);
+  }
+
+  base::DictValue BuildState() const {
+    const GURL server =
+        syncer::AlerseSyncAccount::GetServerURL(*profile_->GetPrefs());
+    const syncer::SyncService* sync = GetSyncService();
+    // The sync service runs the way the app started: Alerse sync needs the
+    // setup to have been there at launch.
+    const bool running = sync && sync->IsLocalSyncEnabled();
+
+    base::DictValue state;
+    state.Set("server", server.is_valid() ? server.spec() : std::string());
+    state.Set("restartNeeded",
+              restart_needed_ || server.is_valid() != running);
+
+    std::string status = "off";
+    if (running && server.is_valid()) {
+      using TransportState = syncer::SyncService::TransportState;
+      switch (sync->GetTransportState()) {
+        case TransportState::DISABLED:
+        case TransportState::PAUSED:
+          status = "stopped";
+          break;
+        case TransportState::START_DEFERRED:
+        case TransportState::INITIALIZING:
+        case TransportState::PENDING_DESIRED_CONFIGURATION:
+        case TransportState::CONFIGURING:
+          status = "starting";
+          break;
+        case TransportState::ACTIVE:
+          status = "active";
+          break;
+      }
+      if (sync->GetUserSettings()->IsPassphraseRequired()) {
+        status = "wrongCode";
+      } else if (sync->GetAuthError().state() !=
+                 GoogleServiceAuthError::NONE) {
+        status = "refused";
+      } else if (sync->HasUnrecoverableError()) {
+        status = "error";
+      }
+      state.Set("lastSynced",
+                ToJsTime(sync->GetLastSyncedTimeForDebugging()));
+    }
+    state.Set("status", status);
+    return state;
+  }
+
+  void HandleGetState(const base::ListValue& args) {
+    web_ui()->ResolveJavascriptCallback(args[0], BuildState());
+  }
+
+  void HandleCreateChain(const base::ListValue& args) {
+    const std::string& callback_id = args[0].GetString();
+    const GURL server = NormalizeServerURL(args[1].GetString());
+    if (!server.is_valid()) {
+      Reject(callback_id,
+             "Enter the server's address, such as https://sync.example.com.");
+      return;
+    }
+    const syncer::SyncChainSecret secret = syncer::GenerateSyncChainSecret();
+    base::DictValue result;
+    result.Set("code", syncer::EncodeSyncCode(secret));
+    CheckServerAndSave(callback_id, server, secret, std::move(result));
+  }
+
+  void HandleJoinChain(const base::ListValue& args) {
+    const std::string& callback_id = args[0].GetString();
+    const GURL server = NormalizeServerURL(args[1].GetString());
+    if (!server.is_valid()) {
+      Reject(callback_id,
+             "Enter the server's address, such as https://sync.example.com.");
+      return;
+    }
+    const std::optional<syncer::SyncChainSecret> secret =
+        syncer::DecodeSyncCode(args[2].GetString());
+    if (!secret) {
+      Reject(callback_id,
+             "That is not a sync code. Check that all 24 words are there, in "
+             "order.");
+      return;
+    }
+    CheckServerAndSave(callback_id, server, *secret, base::DictValue());
+  }
+
+  void CheckServerAndSave(const std::string& callback_id,
+                          const GURL& server,
+                          const syncer::SyncChainSecret& secret,
+                          base::DictValue result) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = server.GetWithEmptyPath().Resolve("health");
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    health_check_ = network::SimpleURLLoader::Create(std::move(request),
+                                                     kHealthCheckAnnotation);
+    health_check_->SetTimeoutDuration(kHealthCheckTimeout);
+    health_check_->DownloadToString(
+        profile_->GetSharedURLLoaderFactory().get(),
+        base::BindOnce(&AlerseSyncHandler::OnServerChecked,
+                       weak_factory_.GetWeakPtr(), callback_id, server, secret,
+                       std::move(result)),
+        /*max_body_size=*/1024);
+  }
+
+  void OnServerChecked(const std::string& callback_id,
+                       const GURL& server,
+                       const syncer::SyncChainSecret& secret,
+                       base::DictValue result,
+                       std::optional<std::string> body) {
+    health_check_.reset();
+    if (!body) {
+      Reject(callback_id,
+             "The server does not answer. Check the address and that the "
+             "server is running.");
+      return;
+    }
+    GetApplicationContext()->GetOSCryptAsync()->GetInstance(base::BindOnce(
+        &AlerseSyncHandler::OnEncryptorForSave, weak_factory_.GetWeakPtr(),
+        callback_id, server, secret, std::move(result)));
+  }
+
+  void OnEncryptorForSave(const std::string& callback_id,
+                          const GURL& server,
+                          const syncer::SyncChainSecret& secret,
+                          base::DictValue result,
+                          scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+    syncer::AlerseSyncAccount::Save(profile_->GetPrefs(), *encryptor, server,
+                                      secret);
+    // Written now rather than later, so a crash cannot lose the setup.
+    profile_->GetPrefs()->CommitPendingWrite();
+    restart_needed_ = true;
+    web_ui()->ResolveJavascriptCallback(base::Value(callback_id), result);
+    web_ui()->FireWebUIListener("state-changed", BuildState());
+  }
+
+  void HandleShowCode(const base::ListValue& args) {
+    GetApplicationContext()->GetOSCryptAsync()->GetInstance(
+        base::BindOnce(&AlerseSyncHandler::OnEncryptorForCode,
+                       weak_factory_.GetWeakPtr(), args[0].GetString()));
+  }
+
+  void OnEncryptorForCode(const std::string& callback_id,
+                          scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+    const std::optional<syncer::SyncChainSecret> secret =
+        syncer::AlerseSyncAccount::LoadSecret(*profile_->GetPrefs(),
+                                                *encryptor);
+    if (!secret) {
+      Reject(callback_id, "This device has no sync code.");
+      return;
+    }
+    base::DictValue result;
+    result.Set("code", syncer::EncodeSyncCode(*secret));
+    web_ui()->ResolveJavascriptCallback(base::Value(callback_id), result);
+  }
+
+  void HandleLeaveChain(const base::ListValue& args) {
+    syncer::SyncService* sync = GetSyncService();
+    if (sync && sync->IsLocalSyncEnabled()) {
+      // In Alerse the sync service is always a SyncServiceImpl.
+      static_cast<syncer::SyncServiceImpl*>(sync)->LeaveAlerseSyncChain();
+    } else {
+      syncer::AlerseSyncAccount::Clear(profile_->GetPrefs());
+    }
+    profile_->GetPrefs()->CommitPendingWrite();
+    restart_needed_ = true;
+    web_ui()->ResolveJavascriptCallback(args[0], base::DictValue());
+    web_ui()->FireWebUIListener("state-changed", BuildState());
+  }
+
+  void Reject(const std::string& callback_id, const char* message) {
+    web_ui()->RejectJavascriptCallback(base::Value(callback_id),
+                                       base::Value(message));
+  }
+
+  const raw_ptr<ProfileIOS> profile_;
+  bool restart_needed_ = false;
+  std::unique_ptr<network::SimpleURLLoader> health_check_;
+  base::ScopedObservation<syncer::SyncService, syncer::SyncServiceObserver>
+      sync_observation_{this};
+  base::WeakPtrFactory<AlerseSyncHandler> weak_factory_{this};
+};
+
+}  // namespace
+
+AlerseSyncUI::AlerseSyncUI(web::WebUIIOS* web_ui, const std::string& host)
+    : web::WebUIIOSController(web_ui, host) {
+  ProfileIOS* profile = ProfileIOS::FromWebUIIOS(web_ui);
+  web_ui->AddMessageHandler(std::make_unique<AlerseSyncHandler>(profile));
+  web::WebUIIOSDataSource::Add(profile, CreateHTMLSource());
+}
+
+AlerseSyncUI::~AlerseSyncUI() = default;
