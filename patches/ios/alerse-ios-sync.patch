+
+#ifndef IOS_CHROME_BROWSER_WEBUI_UI_BUNDLED_ALERSE_SYNC_UI_H_
+#define IOS_CHROME_BROWSER_WEBUI_UI_BUNDLED_ALERSE_SYNC_UI_H_
+
+#include <string>
+
+#include "ios/web/public/webui/web_ui_ios_controller.h"
+
+// chrome://alerse-sync: sets up Alerse sync, as on desktop. A device
+// starts a sync chain or joins one with its 24-word code.
+class AlerseSyncUI : public web::WebUIIOSController {
+ public:
+  AlerseSyncUI(web::WebUIIOS* web_ui, const std::string& host);
+  AlerseSyncUI(const AlerseSyncUI&) = delete;
+  AlerseSyncUI& operator=(const AlerseSyncUI&) = delete;
+  ~AlerseSyncUI() override;
+};
+
+#endif  // IOS_CHROME_BROWSER_WEBUI_UI_BUNDLED_ALERSE_SYNC_UI_H_
