+// Arcomium: Arc for macOS' Copy URL as Quote: the page's selected text as a
+// Markdown quote, then the page's link; empty without a selection.
+std::u16string GetArcomiumQuote(BrowserWindowInterface* browser) {
+  content::WebContents* contents = chrome::GetArcomiumCopyableContents(browser);
+  content::RenderWidgetHostView* view =
+      contents ? contents->GetRenderWidgetHostView() : nullptr;
+  if (!view) {
+    return std::u16string();
+  }
+  const std::u16string selection(
+      base::TrimWhitespace(view->GetSelectedText(), base::TRIM_ALL));
+  if (selection.empty()) {
+    return std::u16string();
+  }
+  std::u16string quote;
+  for (std::u16string_view line :
+       base::SplitStringPiece(selection, u"\n", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_ALL)) {
+    base::StrAppend(&quote, {u"> ", line, u"\n"});
+  }
+  // The title's brackets are escaped, so the link stays one.
+  std::u16string title = contents->GetTitle();
+  base::ReplaceChars(title, u"[", u"\\[", &title);
+  base::ReplaceChars(title, u"]", u"\\]", &title);
+  base::StrAppend(&quote,
+                  {u"\n[", title, u"](",
+                   base::UTF8ToUTF16(contents->GetVisibleURL().spec()), u")"});
+  return quote;
+}
+
+// Arcomium: menu bar items that are no browser command: answered here, true
+// when `tag` is one of them.
+bool ValidateArcomiumMenuItem(
+    BrowserWindowInterface* browser,
+    int32_t tag,
+    remote_cocoa::mojom::ValidateUserInterfaceItemResult* result) {
+  using arcomium::SpaceCommandState;
+  switch (tag) {
+    case IDC_ARCOMIUM_COPY_URL_QUOTE:
+      result->enable = !GetArcomiumQuote(browser).empty();
+      return true;
+    case IDC_ARCOMIUM_REVEAL_TAB:
+      result->enable = arcomium::GetSpaceCommandState(browser, tag) !=
+                       SpaceCommandState::kUnavailable;
+      return true;
+    case IDC_ARCOMIUM_TOGGLE_PINNED: {
+      // Arc's Collapse Pinned Tabs, Expand Pinned Tabs while collapsed.
+      const SpaceCommandState state =
+          arcomium::GetSpaceCommandState(browser, tag);
+      result->enable = state != SpaceCommandState::kUnavailable;
+      result->new_title.emplace(l10n_util::GetStringUTF16(
+          state == SpaceCommandState::kOn ? IDS_ARCOMIUM_EXPAND_PINNED
+                                          : IDS_ARCOMIUM_COLLAPSE_PINNED));
+      return true;
+    }
+    default:
+      return false;
+  }
+}
