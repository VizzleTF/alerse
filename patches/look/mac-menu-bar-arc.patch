+// Arcomium: fills the part of a menu that follows the window each time it
+// opens, as Arc for macOS' Spaces menu lists the Spaces (after its own
+// items) and its Extensions menu the extensions (before them); see
+// arcomium_menu_bar_hook.h.
+@interface ArcomiumMenuListDelegate : NSObject <NSMenuDelegate>
+- (instancetype)initWithList:(arcomium::MenuBarList)list;
+@end
+
+@implementation ArcomiumMenuListDelegate {
+  arcomium::MenuBarList _list;
+}
+
+- (instancetype)initWithList:(arcomium::MenuBarList)list {
+  if ((self = [super init])) {
+    _list = list;
+  }
+  return self;
+}
+
+- (void)menuNeedsUpdate:(NSMenu*)menu {
+  // The list is what points here, and the separator next to it.
+  for (NSInteger i = menu.numberOfItems - 1; i >= 0; --i) {
+    NSMenuItem* item = [menu itemAtIndex:i];
+    if (item.target == self ||
+        [item.representedObject isEqual:@"arcomium-list"]) {
+      [menu removeItemAtIndex:i];
+    }
+  }
+  BrowserWindowInterface* browser =
+      GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser();
+  if (!browser) {
+    return;
+  }
+  const std::vector<arcomium::MenuBarEntry> entries =
+      arcomium::GetMenuBarList(browser, _list);
+  if (entries.empty()) {
+    return;
+  }
+  const bool spaces = _list == arcomium::MenuBarList::kSpaces;
+  NSInteger index = spaces ? menu.numberOfItems : 0;
+  NSMenuItem* separator = [NSMenuItem separatorItem];
+  separator.representedObject = @"arcomium-list";
+  if (spaces) {
+    [menu insertItem:separator atIndex:index++];
+  }
+  for (size_t i = 0; i < entries.size(); ++i) {
+    NSMenuItem* item =
+        [[NSMenuItem alloc] initWithTitle:base::SysUTF16ToNSString(entries[i].title)
+                                   action:@selector(runEntry:)
+                            keyEquivalent:@""];
+    item.target = self;
+    item.tag = static_cast<NSInteger>(i);
+    item.state = entries[i].checked ? NSControlStateValueOn
+                                    : NSControlStateValueOff;
+    // Arc's Control-1 to -9 for the first nine Spaces (the Space bar has
+    // them as well, before the menu was ever opened).
+    if (spaces && i < 9) {
+      item.keyEquivalent = [NSString stringWithFormat:@"%zu", i + 1];
+      item.keyEquivalentModifierMask = NSEventModifierFlagControl;
+    }
+    if (!entries[i].icon.isNull()) {
+      NSImage* image = gfx::Image(entries[i].icon).ToNSImage();
+      [image setTemplate:entries[i].icon_is_template];
+      item.image = image;
+    }
+    [menu insertItem:item atIndex:index++];
+  }
+  if (!spaces) {
+    [menu insertItem:separator atIndex:index];
+  }
+}
+
+- (BOOL)validateMenuItem:(NSMenuItem*)item {
+  return YES;
+}
+
+- (void)runEntry:(NSMenuItem*)sender {
+  if (BrowserWindowInterface* browser =
+          GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser()) {
+    arcomium::RunMenuBarEntry(browser, _list,
+                              static_cast<size_t>(sender.tag));
+  }
+}
+
+@end
