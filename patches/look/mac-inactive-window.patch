 namespace {
 
+#if BUILDFLAG(IS_MAC)
+// Arcomium: repaints `view` and every view under it that paints to a layer of
+// its own (the others paint into one of these).
+void ArcomiumSchedulePaintLayers(views::View* view) {
+  if (!view->parent() || view->layer()) {
+    view->SchedulePaint();
+  }
+  for (views::View* child : view->children()) {
+    ArcomiumSchedulePaintLayers(child);
+  }
