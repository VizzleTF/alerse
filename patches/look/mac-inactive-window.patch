+// Redraws when the window, or a window of its own (a popover), gains or
+// loses the keyboard: an inactive window's controls are grey.
+- (void)viewDidMoveToWindow {
+  [super viewDidMoveToWindow];
+  NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+  [center removeObserver:self];
+  if (!self.window) {
+    return;
+  }
+  for (NSNotificationName name :
+       {NSWindowDidBecomeKeyNotification, NSWindowDidResignKeyNotification,
+        NSWindowDidBecomeMainNotification, NSWindowDidResignMainNotification,
+        NSApplicationDidBecomeActiveNotification,
+        NSApplicationDidResignActiveNotification}) {
+    [center addObserver:self
+               selector:@selector(activeChanged:)
+                   name:name
+                 object:nil];
+  }
+}
+
+- (void)activeChanged:(NSNotification*)notification {
+  [self setNeedsDisplay:YES];
+}
+
+// Whether the keyboard is in one of Arcomium's "..." and "+" popovers over
+// this window (arcomium_window_mac.h): Arc for macOS rings its controls in
+// grey meanwhile, faces kept.
+- (BOOL)popoverOpen {
+  NSWindow* key = NSApp.keyWindow;
+  return NSApp.active && key.parentWindow == self.window &&
+         [key.identifier isEqualToString:@"ArcomiumPopover"];
+}
+
+- (BOOL)windowActive {
+  NSWindow* key = NSApp.keyWindow;
+  while (key && key != self.window) {
+    key = key.parentWindow;
+  }
+  return NSApp.active && (self.window.isMainWindow || key == self.window);
+}
+
