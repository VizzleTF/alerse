 void ChromeWebContentsViewDelegateViews::OnPerformingDrop(
     const content::DropData& drop_data,
     DropCompletionCallback callback) {
+  // Arcomium: a row dragged from the Arc sidebar does not drop into a page;
+  // only the split drop zone on the page's edges takes it.
+  if (arcomium::SidebarRowDragging()) {
