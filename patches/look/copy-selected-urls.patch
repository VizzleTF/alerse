+bool AlerseCopyPickedUrls(BrowserWindowInterface* browser, bool markdown) {
+  TabStripModel* tabs = browser->GetTabStripModel();
+  if (tabs->selection_model().size() < 2) {
+    return false;
+  }
+  std::vector<std::u16string> lines;
+  for (int index = 0; index < tabs->count(); ++index) {
+    content::WebContents* contents = tabs->GetWebContentsAt(index);
+    const GURL& url = contents->GetVisibleURL();
+    if (!tabs->IsTabSelected(index) || !url.is_valid() || url.IsAboutBlank() ||
+        TabStripModel::IsAlerseEmptySpace(contents)) {
+      continue;
+    }
+    const std::u16string spec = base::UTF8ToUTF16(url.spec());
+    if (!markdown) {
+      lines.push_back(spec);
+      continue;
+    }
+    std::u16string title = contents->GetTitle();
+    base::ReplaceChars(title, u"[", u"\\[", &title);
+    base::ReplaceChars(title, u"]", u"\\]", &title);
+    lines.push_back(base::StrCat({u"[", title, u"](", spec, u")"}));
+  }
+  if (lines.empty()) {
+    return false;
+  }
+  ui::ScopedClipboardWriter scw(ui::ClipboardBuffer::kCopyPaste);
+  scw.WriteText(base::JoinString(lines, u"\n"));
+  return true;
+}
