+// Arcomium: Arc's Spaces menu: a new Space, the shown Space's theme and
+// name, the next and the previous one (Option-Command-Right and -Left).
+// Control-1 to -9 pick a Space from the Space bar.
+NSMenuItem* BuildSpacesMenu(NSApplication* nsapp,
+                            id app_delegate,
+                            const std::u16string& product_name,
+                            bool is_pwa,
+                            bool is_rtl) {
+  if (is_pwa) {
+    return nil;
+  }
+  // clang-format off
+  NSMenuItem* item =
+      Item(IDS_ARCOMIUM_MENU_SPACES)
+          .submenu({
+              Item(IDS_ARCOMIUM_NEW_SPACE)
+                  .command_id(IDC_ARCOMIUM_NEW_SPACE),
+              Item(IDS_ARCOMIUM_MENU_EDIT_THEME)
+                  .command_id(IDC_ARCOMIUM_EDIT_SPACE_THEME),
+              Item(IDS_ARCOMIUM_RENAME_SPACE)
+                  .command_id(IDC_ARCOMIUM_RENAME_SPACE),
+              Item().is_separator(),
+              Item(IDS_ARCOMIUM_MENU_NEXT_SPACE)
+                  .command_id(IDC_ARCOMIUM_NEXT_SPACE),
+              Item(IDS_ARCOMIUM_MENU_PREVIOUS_SPACE)
+                  .command_id(IDC_ARCOMIUM_PREVIOUS_SPACE),
+          })
+          .Build();
+  // clang-format on
+  return item;
+}
