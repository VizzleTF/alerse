   font-size: 12px;
   line-height: 16px;
 }
+
+/* Arcomium: the omnibox's suggestions as rows of Arc's command bar: 48 px
+ * high, 4 px apart and in from the panel's sides, a rounded grey highlight,
+ * the favicon 15 px and the text 43 px in, the URL in grey after an em dash,
+ * no focus bar, action chips or remove button. */
+:host([is-top-chrome-searchbox_]) .container:not(.actions) {
+  border-radius: 6px;
+  box-sizing: border-box;
+  height: 48px;
+  margin: 0 6px 4px 4px;
+  padding: 0;
+  padding-inline-start: 11px;
+}
+
+/* !important: the component shows these with more specific rules. */
+:host([is-top-chrome-searchbox_]) #focusIndicator,
+:host([is-top-chrome-searchbox_]) #actions-container,
+:host([is-top-chrome-searchbox_]) #remove,
+:host([is-top-chrome-searchbox_]) #separator {
+  display: none !important;
+}
+
+/* The text sits 2 px below the row's middle. */
+:host([is-top-chrome-searchbox_]) #text-container {
+  margin-top: 4px;
+  padding-inline-start: 4px;
+}
+
+:host([is-top-chrome-searchbox_]) #contents {
+  color: rgb(255, 255, 255);
+}
+
+:host([is-top-chrome-searchbox_]) .match {
+  font-weight: inherit;
+}
+
+:host([is-top-chrome-searchbox_]) #description,
+:host([is-top-chrome-searchbox_]) #description .url {
+  color: rgb(199, 199, 199);
+}
+
+:host([is-top-chrome-searchbox_]) #description:not(:empty)::before {
+  content: ' — ';
+}
