+// Arcomium: Arc's fuzzy match. 0 unless every letter of `query` (spaces
+// dropped) appears in `text` in order; otherwise higher the tighter they sit
+// and the earlier they start, up to 1.
+double ArcomiumFuzzyFactor(const std::u16string& query,
+                           const std::u16string& text) {
+  size_t first = std::u16string::npos;
+  size_t last = 0;
+  size_t letters = 0;
+  size_t at = 0;
+  for (char16_t c : query) {
+    if (c == u' ') {
+      continue;
+    }
+    at = text.find(c, at);
+    if (at == std::u16string::npos) {
+      return 0;
+    }
+    if (first == std::u16string::npos) {
+      first = at;
+    }
+    last = at++;
+    ++letters;
+  }
+  if (!letters) {
+    return 0;
+  }
+  const double tightness = double(letters) / double(last - first + 1);
+  const double start = 1.0 / (1.0 + first / 10.0);
+  return tightness * 0.75 + start * 0.25;
+}
