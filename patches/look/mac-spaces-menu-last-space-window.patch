+// Alerse: the Spaces list follows the last Space window, not an Incognito or
+// Little window that was active after it.
+- (BrowserWindowInterface*)listBrowser {
+  if (_list != alerse::MenuBarList::kSpaces) {
+    return GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser();
+  }
+  BrowserWindowInterface* found = nullptr;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&found](BrowserWindowInterface* browser) {
+        if (browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+            !browser->GetProfile()->IsOffTheRecord()) {
+          found = browser;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  return found;
+}
