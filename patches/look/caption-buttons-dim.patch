+
+bool BrowserFrameViewWin::IsArcomiumCaptionOverlay() const {
+  return GetBrowserView()->IsArcomiumSidebarShown() &&
+         !browser_widget()->IsFullscreen() &&
+         !GetBrowserView()->IsWindowControlsOverlayEnabled();
+}
+
+void BrowserFrameViewWin::UpdateArcomiumCaptionReveal() {
+  // Room around the buttons where the pointer brightens them, and how long
+  // they stay bright after it leaves, so that reaching for them is forgiving.
+  constexpr int kRevealMargin = 12;
+  constexpr base::TimeDelta kHideDelay = base::Milliseconds(250);
+
+  const bool overlay = IsArcomiumCaptionOverlay();
+  bool reveal = false;
+  if (overlay && GetWidget()) {
+    gfx::Point cursor = display::Screen::Get()->GetCursorScreenPoint();
+    views::View::ConvertPointFromScreen(this, &cursor);
+    const gfx::Size buttons = caption_button_container_->GetPreferredSize();
+    const gfx::Rect zone(width() - buttons.width() - kRevealMargin, 0,
+                         buttons.width() + kRevealMargin,
+                         WindowTopY() + buttons.height() + kRevealMargin);
+    reveal = zone.Contains(cursor);
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (reveal) {
+    arcomium_caption_left_at_ = base::TimeTicks();
+  } else if (overlay && arcomium_caption_revealed_) {
+    if (arcomium_caption_left_at_.is_null()) {
+      arcomium_caption_left_at_ = now;
+    }
+    reveal = now - arcomium_caption_left_at_ < kHideDelay;
+  }
+
+  // While they are bright, the pointer may leave the window over them
+  // without passing the page, so keep looking.
+  if (reveal && !arcomium_caption_timer_.IsRunning()) {
+    arcomium_caption_timer_.Start(
+        FROM_HERE, base::Milliseconds(100), this,
+        &BrowserFrameViewWin::UpdateArcomiumCaptionReveal);
+  } else if (!reveal) {
+    arcomium_caption_timer_.Stop();
+  }
+
+  if (reveal != arcomium_caption_revealed_ ||
+      overlay != arcomium_caption_overlay_) {
+    arcomium_caption_revealed_ = reveal;
+    LayoutCaptionButtons();
+  }
+}
