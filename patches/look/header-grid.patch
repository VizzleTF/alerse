+VerticalTabStripTopContainer::ArcHeaderGrid
+VerticalTabStripTopContainer::GetArcHeaderGrid() const {
+  ArcHeaderGrid grid{.first_row_center = kArcHeaderHeight / 2};
+  if (caption_button_width_ <= 0) {
+    // No window controls lead the row: it starts at the address bar's edge,
+    // and sits where they would.
+    // The strip may sit in a widget of its own: measure from the window.
+    if (const views::Widget* window =
+            GetWidget() ? GetWidget()->GetTopLevelWidget() : nullptr) {
+      gfx::Point edge = window->GetWindowBoundsInScreen().origin() +
+                        gfx::Vector2d(kArcHeaderEdge, kArcHeaderCenter);
+      views::View::ConvertPointFromScreen(this, &edge);
+      grid.first_row_x = grid.second_row_x = std::max(0, edge.x());
+      grid.first_row_center = std::max(kArcHeaderButtonSize / 2, edge.y());
+    }
+    return grid;
+  }
+  grid.first_row_x = caption_button_width_ + kArcHeaderCaptionGap;
+  // The browser window's frame, which places the window controls.
+  const views::Widget* window =
+      GetWidget() ? GetWidget()->GetTopLevelWidget() : nullptr;
+  const views::NonClientView* non_client =
+      window ? window->non_client_view() : nullptr;
+  const BrowserFrameView* frame =
+      non_client ? static_cast<const BrowserFrameView*>(non_client->frame_view())
+                 : nullptr;
+  if (!frame) {
+    return grid;
+  }
+  // The window controls' margins are even, so their top and left edges lie as
+  // far in as their bottom and right paddings.
+  const BrowserLayoutParams params = frame->GetBrowserLayoutParams();
+  const BrowserLayoutExclusionArea& controls = params.leading_exclusion;
+  const int top = base::ClampRound(controls.vertical_padding);
+  const int bottom = params.visual_client_area.y() +
+                     base::ClampRound(controls.content.height());
+  gfx::Point leading(base::ClampRound(controls.horizontal_padding),
+                     (top + bottom) / 2);
+  gfx::Point trailing(params.visual_client_area.x() +
+                          base::ClampRound(controls.content.width()),
+                      0);
+  views::View::ConvertPointToScreen(frame, &leading);
+  views::View::ConvertPointToScreen(frame, &trailing);
+  views::View::ConvertPointFromScreen(this, &leading);
+  views::View::ConvertPointFromScreen(this, &trailing);
+  grid.first_row_x = trailing.x() + kArcHeaderCaptionGap;
+  grid.second_row_x = std::max(0, leading.x());
+  grid.first_row_center = std::max(kArcHeaderButtonSize / 2, leading.y());
+  return grid;
+}
