+
+bool VerticalTabStripRegionView::IsArcomiumFloating() const {
+  return state_controller_->IsCollapsed() && is_expanded_on_hover_;
+}
+
+void VerticalTabStripRegionView::UpdateArcomiumFloating() {
+  const bool hidden = state_controller_->IsCollapsed();
+  const bool floating = IsArcomiumFloating();
+  // The Arc sidebar, not Chromium's tab list, floats.
+  if (tab_strip_view()) {
+    tab_strip_view()->SetCollapsedState(hidden && !floating);
+  }
+  top_button_container_->SetArcomiumFloating(floating);
+  bottom_button_container_->UpdateButtonStyles(hidden && !floating);
+  if (GetWidget()) {
+#if BUILDFLAG(IS_MAC)
+    // Elsewhere the window controls stay in the top bar.
+    arcomium::SetWindowControlsHidden(GetWidget(), hidden && !floating,
+                                      floating);
+#endif
+  }
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+void VerticalTabStripRegionView::OnPaintBackground(gfx::Canvas* canvas) {
+  if (!IsArcomiumFloating()) {
+    BaseTabStripRegionView::OnPaintBackground(canvas);
+    return;
+  }
+  // Arc for macOS' floating sidebar: #0D0D0D with 11 pt corners and a 1 pt
+  // #565656 rim.
+  constexpr float kRadius = 11;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SkColorSetRGB(0x0D, 0x0D, 0x0D));
+  gfx::RectF panel(GetLocalBounds());
+  canvas->DrawRoundRect(panel, kRadius, flags);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(1);
+  flags.setColor(SkColorSetRGB(0x56, 0x56, 0x56));
+  panel.Inset(0.5f);
+  canvas->DrawRoundRect(panel, kRadius - 0.5f, flags);
+}
