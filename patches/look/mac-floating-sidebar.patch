+// Implemented by the browser window's frame
+// (browser_native_widget_window_mac.mm).
+@interface NSView (ArcomiumWindowControls)
+- (void)setArcomiumFloatingControls:(BOOL)floating;
+@end
+
+namespace arcomium {
+
+void SetWindowControlsHidden(views::Widget* widget,
+                             bool hidden,
+                             bool floating) {
+  NSWindow* window = widget->GetNativeWindow().GetNativeNSWindow();
+  for (NSWindowButton type : {NSWindowCloseButton, NSWindowMiniaturizeButton,
+                              NSWindowZoomButton}) {
+    [window standardWindowButton:type].hidden = hidden;
+  }
+  // The frame moves them into the floating sidebar and redraws Arc's look.
+  NSView* frame = window.contentView.superview;
+  if ([frame respondsToSelector:@selector(setArcomiumFloatingControls:)]) {
+    [frame setArcomiumFloatingControls:floating];
+  }
+}
+
+}  // namespace arcomium
