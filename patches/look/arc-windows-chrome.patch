+    site->SetTooltipText(u"Site settings");
+    site->GetViewAccessibility().SetName(u"Site settings");
+    site->SetVisible(false);
+    arcomium_site_button_ = AddChildView(std::move(site));
+  }
+  // Arc for Windows sets the address in a smaller face than an edited one.
+  if (centered) {
+    arcomium_default_font_ = omnibox_view_->GetFontList();
+    omnibox_view_->SetFontList(
+        arcomium_default_font_->DeriveWithSizeDelta(-2));
+  } else if (arcomium_default_font_) {
+    omnibox_view_->SetFontList(*arcomium_default_font_);
+    arcomium_default_font_.reset();
+    omnibox_view_->InstallPlaceholderText();
+  }
+  RefreshBackground();
+  InvalidateLayout();
+}
+
+bool LocationBarView::IsArcomiumCenteredIdle() const {
+  return arcomium_centered_ && arcomium_compact_ && !omnibox_view_->HasFocus();
+}
+
+SkColor LocationBarView::GetArcomiumPillColor() const {
+  // A shade off the frame, as Arc for Windows' pill is.
+  return color_utils::BlendTowardMaxContrast(
+      GetColorProvider()->GetColor(ui::kColorFrameActive), 0x0B);
+}
+
+void LocationBarView::CopyArcomiumAddress() {
+  content::WebContents* contents = GetWebContents();
+  if (!contents || contents->GetVisibleURL().is_empty()) {
+    return;
+  }
+  ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+      .WriteText(base::UTF8ToUTF16(contents->GetVisibleURL().spec()));
+}
+
+void LocationBarView::LayoutArcomiumCentered() {
+  // Arc for Windows' metrics: 16 px icon boxes 8 px off a 27 px pill whose
+  // text has 8 px of room before it and 10 after.
+  constexpr int kIconSize = 16;
+  constexpr int kGap = 8;
+  constexpr int kPillPadding = 8;
+  constexpr int kPillTrailingPadding = 10;
+  constexpr int kPillHeight = 28;
+  static constexpr char16_t kPlaceholder[] = u"Search or Enter URL...";
+  if (omnibox_view_->GetPlaceholderText() != kPlaceholder) {
+    omnibox_view_->SetPlaceholderText(kPlaceholder);
+  }
+  const std::u16string text = omnibox_view_->GetText().empty()
+                                  ? std::u16string(kPlaceholder)
+                                  : omnibox_view_->GetText();
+  const int max_text_width =
+      std::max(0, width() - 2 * (kIconSize + kGap + kPillPadding));
+  const int text_width = std::min(
+      gfx::GetStringWidth(text, omnibox_view_->GetFontList()) + 1,
+      max_text_width);
+  const int pill_width = text_width + kPillPadding + kPillTrailingPadding;
+  const int group_width = 2 * (kIconSize + kGap) + pill_width;
+  // Where Arc for Windows centres it: 2 px left of the toolbar's middle.
+  constexpr int kCenterOffset = -2;
+  const int center =
+      (parent() ? parent()->width() / 2 - x() : width() / 2) + kCenterOffset;
+  const int left = std::clamp(center - group_width / 2, 0,
+                              std::max(0, width() - group_width));
+  const int center_y = height() / 2;
+  // Its icons sit a pixel above the pill's middle.
+  const int icon_y = center_y - kIconSize / 2 - 1;
+  arcomium_copy_button_->SetBounds(left, icon_y, kIconSize, kIconSize);
+  arcomium_copy_button_->SetVisible(true);
+  arcomium_pill_bounds_ =
+      gfx::Rect(left + kIconSize + kGap, center_y - kPillHeight / 2,
+                pill_width, kPillHeight);
+  omnibox_view_->SetBounds(arcomium_pill_bounds_.x() + kPillPadding,
+                           omnibox_view_->y(), text_width,
+                           omnibox_view_->height());
+  location_icon_view_->SetVisible(false);
+  arcomium_site_button_->SetBounds(arcomium_pill_bounds_.right() + kGap,
+                                   icon_y, kIconSize, kIconSize);
+  arcomium_site_button_->SetVisible(true);
+}
+
+void LocationBarView::OnPaintBackground(gfx::Canvas* canvas) {
+  views::View::OnPaintBackground(canvas);
+  if (arcomium_pill_bounds_.IsEmpty()) {
+    return;
+  }
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(GetArcomiumPillColor());
+  // Its top and bottom edges fall between pixels, as in Arc for Windows.
+  gfx::RectF pill(arcomium_pill_bounds_);
+  pill.Inset(gfx::InsetsF::VH(0.5f, 0.f));
+  canvas->DrawRoundRect(pill, 7, flags);
+}
