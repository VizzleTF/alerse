+  arcomium_tinted_keys_.clear();
 }
 
 void ColorProviderManager::AppendColorProviderInitializer(
@@ -125,6 +126,17 @@ ColorProvider* ColorProviderManager::GetColorProviderFor(ColorProviderKey key) {
       });
     }
 
+    // Arcomium: a window tinted by a Space (an app background color with no
+    // web app behind it) keeps its providers bounded, oldest out first;
+    // a window still using an evicted one gets it built again.
+    if (key.app_background_color && !key.app_controller) {
+      constexpr size_t kMaxArcomiumTintedProviders = 32;
+      while (arcomium_tinted_keys_.size() >= kMaxArcomiumTintedProviders) {
+        color_providers_.erase(arcomium_tinted_keys_.front());
+        arcomium_tinted_keys_.pop_front();
+      }
+      arcomium_tinted_keys_.push_back(key);
+    }
     iter = color_providers_.emplace(key, std::move(provider)).first;
     RecordColorProviderCacheSize(static_cast<int>(color_providers_.size()));
   }
