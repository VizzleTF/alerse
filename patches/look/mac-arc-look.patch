+
+// Arc for macOS' panel edge: a one-pixel near-black ring outside its 1 pt rim.
+// The host reaches a point further out at the sides and bottom (Layout()), so
+// the rows keep their places.
+class AlerseRimBorder : public views::Border {
+ public:
+  explicit AlerseRimBorder(SkColor rim) : rim_(rim) {}
+
+  void Paint(const views::View& view, gfx::Canvas* canvas) override {
+    gfx::ScopedCanvas scoped(canvas);
+    const float scale = canvas->UndoDeviceScaleFactor();
+    const gfx::RectF bounds =
+        gfx::ScaleRect(gfx::RectF(view.GetLocalBounds()), scale);
+    const float radius = kAlerseCommandBarRadius * scale;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1);
+    flags.setColor(SkColorSetRGB(0x03, 0x03, 0x03));
+    gfx::RectF ring = bounds;
+    ring.Inset(0.5f);
+    canvas->DrawRoundRect(ring, radius - 0.5f, flags);
+    flags.setStrokeWidth(scale);
+    flags.setColor(rim_);
+    gfx::RectF rim = bounds;
+    rim.Inset(1 + scale / 2);
+    canvas->DrawRoundRect(rim, radius - 1 - scale / 2, flags);
+  }
+
+  gfx::Insets GetInsets() const override {
+    return gfx::Insets::TLBR(1, 2, 2, 2);
+  }
+
+  gfx::Size GetMinimumSize() const override { return gfx::Size(4, 3); }
+
+ private:
+  const SkColor rim_;
+};
+
+// Arc for macOS' command bar casts a broad, soft shadow, darkest under it:
