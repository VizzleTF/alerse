+// beside it and 15% over it (8% 20 pt up).
+gfx::ShadowValues AlerseCommandBarShadows() {
+  return {gfx::ShadowValue(gfx::Vector2d(0, 20), 218,
+                           SkColorSetA(SK_ColorBLACK, 0x87))};
+}
+
+gfx::Insets AlerseCommandBarShadowInsets() {
+  return -gfx::ShadowValue::GetMargin(AlerseCommandBarShadows());
+}
+
+class AlerseShadowBorder : public views::Border {
+ public:
+  void Paint(const views::View& view, gfx::Canvas* canvas) override {
+    gfx::RectF panel(view.GetLocalBounds());
+    panel.Inset(gfx::InsetsF(GetInsets()));
+    const SkRRect rrect =
+        SkRRect::MakeRectXY(gfx::RectFToSkRect(panel),
+                            kAlerseCommandBarRadius, kAlerseCommandBarRadius);
+    gfx::ScopedCanvas scoped(canvas);
+    // Only the shadow: the panel paints itself.
+    canvas->sk_canvas()->clipRRect(rrect, SkClipOp::kDifference, true);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SK_ColorBLACK);
+    flags.setLooper(gfx::CreateShadowDrawLooper(AlerseCommandBarShadows()));
+    canvas->sk_canvas()->drawRRect(rrect, flags);
+  }
+
+  gfx::Insets GetInsets() const override {
+    return AlerseCommandBarShadowInsets();
+  }
