diff --git a/chrome/browser/ui/color/chrome_color_mixers.cc b/chrome/browser/ui/color/chrome_color_mixers.cc
index a71c593f719..42803f46b49 100644
--- a/chrome/browser/ui/color/chrome_color_mixers.cc
+++ b/chrome/browser/ui/color/chrome_color_mixers.cc
@@ -124,6 +124,14 @@ void AddChromeColorMixers(ui::ColorProvider* provider,
   }
 #endif
 
+  // Arcomium: the active Space's theme color tints the window frame, behind
+  // the sidebar (BrowserWidget::GetColorProviderKey()).
+  if (!key.app_controller && key.app_background_color) {
+    ui::ColorMixer& mixer = provider->AddMixer();
+    mixer[ui::kColorFrameActive] = {*key.app_background_color};
+    mixer[ui::kColorFrameInactive] = {*key.app_background_color};
+  }
+
   if (key.custom_theme) {
     key.custom_theme->AddColorMixers(provider, key);
   }
diff --git a/chrome/browser/ui/views/frame/browser_widget.cc b/chrome/browser/ui/views/frame/browser_widget.cc
index 4de6ce6bd14..4793ec687d7 100644
--- a/chrome/browser/ui/views/frame/browser_widget.cc
+++ b/chrome/browser/ui/views/frame/browser_widget.cc
@@ -476,6 +476,13 @@ void BrowserWidget::OnNativeThemeUpdated(ui::NativeTheme* observed_theme) {
   UserChangedTheme(BrowserThemeChangeType::kNativeTheme);
 }
 
+namespace arcomium {
+// The active Space's theme color, set by arcomium_space_color.cc: native window
+// properties are keyed by this very pointer.
+extern const char kSpaceTintWindowProperty[];
+const char kSpaceTintWindowProperty[] = "arcomium.space_tint";
+}  // namespace arcomium
+
 ui::ColorProviderKey BrowserWidget::GetColorProviderKey() const {
   auto key = Widget::GetColorProviderKey();
 
@@ -501,6 +508,11 @@ ui::ColorProviderKey BrowserWidget::GetColorProviderKey() const {
           web_app::AppBrowserController::From(browser_view_->browser())) {
     key.app_controller = app_controller;
     key.app_background_color = app_controller->GetBackgroundColor();
+  } else if (void* tint =
+                 GetNativeWindowProperty(arcomium::kSpaceTintWindowProperty)) {
+    // Arcomium: the active Space's theme color (arcomium_space_color.cc).
+    key.app_background_color =
+        static_cast<SkColor>(reinterpret_cast<uintptr_t>(tint));
   }
 
