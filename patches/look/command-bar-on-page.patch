+  const SkColor grey = color_utils::IsDark(GetColorProvider()->GetColor(
+                           ui::kColorFrameActive))
+                           ? SkColorSetRGB(0xAE, 0xAE, 0xAE)
+                           : SkColorSetRGB(0x51, 0x51, 0x51);
+  return alerse::InkOverFrame(this, grey);
