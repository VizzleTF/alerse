 namespace {
 
+// Arcomium: the command line's loose arguments that are tab URLs. On macOS a
+// Cocoa argument-domain pair such as "-AppleLanguages (de)" (how a Mac app
+// is started in another language) reads as the switch "-AppleLanguages" and
+// a loose "(de)", which opened as http://(de)/; such values are skipped. The
+// process' own argv keeps the pairs together, which CommandLine reorders.
+base::CommandLine::StringVector GetTabArgs(
+    const base::CommandLine& command_line) {
+  base::CommandLine::StringVector args = command_line.GetArgs();
+#if BUILDFLAG(IS_MAC)
+  // Only this process' own command line (not one another launch handed
+  // over) matches its argv.
+  if (command_line.argv() != base::CommandLine::ForCurrentProcess()->argv()) {
+    return args;
+  }
+  char** argv = *_NSGetArgv();
+  const int argc = *_NSGetArgc();
+  for (int i = 1; i + 1 < argc; ++i) {
+    const std::string_view key(argv[i]);
+    if (key == "--") {
+      break;
+    }
+    if (!key.starts_with("--") &&
+        (key.starts_with("-Apple") || key.starts_with("-NS")) &&
+        argv[i + 1][0] != '-') {
+      if (auto it = std::ranges::find(args, argv[i + 1]); it != args.end()) {
+        args.erase(it);
+      }
+      ++i;
+    }
+  }
+#endif
+  return args;
+}
