+void VerticalTabStripRegionView::UpdateAlerseFloatSlide(
+    const BrowserAnimationController* controller,
+    BrowserAnimationUpdate status) {
+  // Leaving lasts as long as the motion that hides the panel. A motion
+  // canceled as that one starts is the reveal's, which it replaces.
+  const bool was_leaving = alerse_float_leaving_;
+  if (status == BrowserAnimationUpdate::kEnded ||
+      (status != BrowserAnimationUpdate::kCanceled &&
+       controller->GetCurrentMotion(TabStripAnimations::kVerticalTabStrip) !=
+           TabStripAnimations::kCollapseOnHover)) {
+    alerse_float_leaving_ = false;
+  }
+  if (was_leaving != alerse_float_leaving_) {
+    UpdateAlerseFloating();
+  }
+  // The panel is laid out at its place and moves on its layer: none of its
+  // rows is laid out or painted again while it slides. Hidden, its trailing
+  // 5 pt stay under the pointer at the window's edge, which keeps it open.
+  const double shown =
+      controller
+          ->GetCurrentValue(TabStripAnimations::kVerticalTabStrip,
+                            TabStripAnimations::kTabStripHoverWidth)
+          .value_or(0.0);
+  gfx::Transform transform;
+  if (IsAlerseFloating() && shown < 1.0) {
+    const float hidden = (1.0 - shown) * std::max(0, width() - 5);
+    transform.Translate(base::i18n::IsRTL() ? hidden : -hidden, 0);
+  }
+  if (layer()->GetTargetTransform() != transform) {
+    layer()->SetTransform(transform);
+  }
 }
 
