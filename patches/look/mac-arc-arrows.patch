+
+// Arc for macOS' arrows, larger than its other header icons: the icon color;
+// dimmed, white at 25% over the frame (#525252 on #161616, #6A6A6A on an
+// inactive window's #393939), where Chromium's disabled grey is brighter.
+class ArcMacArrowButton : public views::ImageButton {
+  METADATA_HEADER(ArcMacArrowButton, views::ImageButton)
+
+ public:
+  ArcMacArrowButton(PressedCallback callback, const gfx::VectorIcon& icon)
+      : views::ImageButton(std::move(callback)), icon_(icon) {
+    views::ConfigureVectorImageButton(this);
+  }
+
+  void AddedToWidget() override {
+    views::ImageButton::AddedToWidget();
+    paint_as_active_subscription_ =
+        GetWidget()->RegisterPaintAsActiveChangedCallback(base::BindRepeating(
+            &ArcMacArrowButton::UpdateImages, base::Unretained(this)));
+  }
+
+  void RemovedFromWidget() override {
+    paint_as_active_subscription_ = {};
+    views::ImageButton::RemovedFromWidget();
+  }
+
+  void OnThemeChanged() override {
+    views::ImageButton::OnThemeChanged();
+    UpdateImages();
+  }
+
+ private:
+  void UpdateImages() {
+    if (!GetColorProvider()) {
+      return;
+    }
+    views::SetImageFromVectorIconWithColor(
+        this, *icon_, kArcMacIconSize,
+        {GetColorProvider()->GetColor(ui::kColorIcon),
+         color_utils::BlendTowardMaxContrast(alerse::FrameColor(this),
+                                             0x40)});
+  }
+
+  const raw_ref<const gfx::VectorIcon> icon_;
+  base::CallbackListSubscription paint_as_active_subscription_;
+};
+
+BEGIN_METADATA(ArcMacArrowButton)
+END_METADATA
 #endif
 
