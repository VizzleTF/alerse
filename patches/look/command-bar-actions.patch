+ * its keyboard shortcut at the row's end on a key chip of the same colors. */
+:host([is-top-chrome-searchbox_]) .alerse-action cr-searchbox-icon {
+  --color-searchbox-answer-icon-background: rgb(37, 37, 37);
+  --color-searchbox-answer-icon-foreground: rgb(181, 181, 181);
+  --cr-searchbox-icon-border-radius: 5px;
+  --cr-searchbox-icon-container-size: 24px;
+  margin-inline: 4px;
+}
+
+:host([is-top-chrome-searchbox_][selected]) .alerse-action cr-searchbox-icon {
+  --color-searchbox-answer-icon-background: rgb(255, 255, 255);
