+content::WebContents* GetAlerseCopyableContents(
+    BrowserWindowInterface* browser) {
+  content::WebContents* contents =
+      browser->GetTabStripModel()->GetActiveWebContents();
+  if (!contents || !contents->GetVisibleURL().is_valid() ||
+      contents->GetVisibleURL().IsAboutBlank() ||
+      TabStripModel::IsAlerseEmptySpace(contents)) {
+    return nullptr;
+  }
+  return contents;
+}
+
+void AlerseCopyUrlAsMarkdown(BrowserWindowInterface* browser,
+                               content::WebContents* web_contents) {
+  // The title's brackets are escaped, so the link stays one.
+  std::u16string title = web_contents->GetTitle();
+  base::ReplaceChars(title, u"[", u"\\[", &title);
+  base::ReplaceChars(title, u"]", u"\\]", &title);
+  ui::ScopedClipboardWriter scw(ui::ClipboardBuffer::kCopyPaste);
+  scw.WriteText(base::StrCat(
+      {u"[", title, u"](",
+       base::UTF8ToUTF16(web_contents->GetVisibleURL().spec()), u")"}));
+#if !BUILDFLAG(IS_ANDROID)
+  if (toast_features::IsEnabled(toast_features::kLinkCopiedToast)) {
+    if (ToastController* const toast_controller =
+            ToastController::From(browser)) {
+      toast_controller->MaybeShowToast(ToastParams(ToastId::kLinkCopied));
+    }
+  }
+#endif
+}
+
 bool CanCopyUrl(BrowserWindowInterface* browser) {
   return IsWebAppOrCustomTab(browser) ||
          !sharing_hub::SharingIsDisabledByPolicy(browser->GetProfile());
