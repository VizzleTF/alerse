+std::u16string LocationBarView::GetAlerseKeywordHint() const {
+  if (!alerse_command_bar_ || !omnibox_view_) {
+    return std::u16string();
+  }
+  const OmniboxEditModel* model = GetOmniboxController()->edit_model();
+  if (!model->is_keyword_hint() || model->keyword().empty()) {
+    return std::u16string();
+  }
+  const TemplateURLService* service =
+      profile_ ? TemplateURLServiceFactory::GetForProfile(profile_) : nullptr;
+  const TemplateURL* turl =
+      service ? service->GetTemplateURLForKeyword(model->keyword()) : nullptr;
+  if (!turl || turl->short_name().empty()) {
+    return std::u16string();
+  }
+  return l10n_util::GetStringFUTF16(IDS_ALERSE_SEARCH_SITE,
+                                    turl->short_name());
+}
+
+int LocationBarView::GetAlerseKeywordHintWidth() const {
+  const std::u16string hint = GetAlerseKeywordHint();
+  if (hint.empty()) {
+    return 0;
+  }
+  const gfx::FontList font = AlerseHintFont(omnibox_view_->GetFontList());
+  return gfx::GetStringWidth(hint, font) + kAlerseHintGap +
+         gfx::GetStringWidth(l10n_util::GetStringUTF16(IDS_ALERSE_TAB_KEY),
+                             font) +
+         2 * kAlerseHintChipPadding;
+}
+
+void LocationBarView::PaintAlerseKeywordHint(gfx::Canvas* canvas) {
+  const std::u16string hint = GetAlerseKeywordHint();
+  if (hint.empty()) {
+    return;
+  }
+  const ui::ColorProvider* colors = GetColorProvider();
+  const gfx::FontList font = AlerseHintFont(omnibox_view_->GetFontList());
+  const std::u16string key = l10n_util::GetStringUTF16(IDS_ALERSE_TAB_KEY);
+  const int chip_width =
+      gfx::GetStringWidth(key, font) + 2 * kAlerseHintChipPadding;
+  const gfx::Rect chip(width() - kAlerseHintEndInset - chip_width,
+                       (height() - kAlerseHintChipHeight) / 2, chip_width,
+                       kAlerseHintChipHeight);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(color_utils::BlendTowardMaxContrast(
+      colors->GetColor(kColorOmniboxResultsBackground), 0x0C));
+  canvas->DrawRoundRect(gfx::RectF(chip), 5, flags);
+  canvas->DrawStringRectWithFlags(key, font,
+                                  colors->GetColor(kColorOmniboxTextDimmed),
+                                  chip, gfx::Canvas::TEXT_ALIGN_CENTER);
+  const int text_width = gfx::GetStringWidth(hint, font);
+  canvas->DrawStringRect(
+      hint, font, colors->GetColor(kColorOmniboxTextDimmed),
+      gfx::Rect(chip.x() - kAlerseHintGap - text_width, 0, text_width,
+                height()));
+}
+
+ui::ImageModel LocationBarView::GetAlerseCommandBarIcon() {
+  OmniboxEditModel* model = GetOmniboxController()->edit_model();
+  if (!model->user_input_in_progress() || omnibox_view_->GetText().empty()) {
+    return ui::ImageModel();
+  }
+  const AutocompleteMatch match = model->CurrentMatch();
+  if (AutocompleteMatch::IsSearchType(match.type) &&
+      !model->is_keyword_selected()) {
+    return ui::ImageModel();
+  }
+  const SkColor color = GetColorProvider()->GetColor(kColorOmniboxText);
+  return omnibox_view_->GetIcon(
+      16, color, color, color, color,
+      base::BindOnce(&LocationBarView::OnAlerseIconFetched,
+                     weak_factory_.GetWeakPtr()),
+      /*dark_mode=*/true);
+}
+
+void LocationBarView::OnAlerseIconFetched(const gfx::Image& icon) {
+  SchedulePaint();
+}
