+  margin-inline: auto 10px;
+  padding: 0 7px;
+  white-space: nowrap;
+}
+
+:host([is-top-chrome-searchbox_][selected]) #alerseShortcut {
+  background-color: rgb(255, 255, 255);
+  color: rgb(93, 93, 93);
+}
+
+<if expr="is_macosx">
+/* Alerse: Arc for macOS' key chips space their glyphs (the shortcut text
+ * is AppKit's, as "⇧⌘C"; elsewhere it is spelled out, "Ctrl+Shift+C"). */
+@media all {
+  :host([is-top-chrome-searchbox_]) #alerseShortcut {
+    letter-spacing: 3px;
+    padding-inline: 7px 4px;
+  }
+}
+</if>
+
+/* Alerse: as Arc for macOS, a row's address after the title is #656565,
