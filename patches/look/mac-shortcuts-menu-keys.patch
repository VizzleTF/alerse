+
+bool GetMacMenuAcceleratorForCommandId(int command_id,
+                                       ui::Accelerator* accelerator) {
+  const ui::Accelerator* menu_accelerator =
+      AcceleratorsCocoa::GetInstance()->GetAcceleratorForCommand(command_id);
+  if (menu_accelerator) {
+    *accelerator = *menu_accelerator;
+  }
+  return menu_accelerator != nullptr;
+}
