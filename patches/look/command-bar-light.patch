@@ -125,3 +125,22 @@
     #action-icon::after {
   background-color: rgb(93, 93, 93);
 }
+
+/* Alerse: Switch to Tab's arrow square on a light theme. */
+@media (prefers-color-scheme: light) {
+  :host-context(cr-searchbox-match[is-top-chrome-searchbox_]) #action-icon {
+    background-color: rgb(218, 218, 218);
+  }
+
+  :host-context(cr-searchbox-match[is-top-chrome-searchbox_]) #action-icon::after {
+    background-color: rgb(74, 74, 74);
+  }
+
+  :host-context(cr-searchbox-match[is-top-chrome-searchbox_][selected]) #action-icon {
+    background-color: rgb(30, 30, 30);
+  }
+
+  :host-context(cr-searchbox-match[is-top-chrome-searchbox_][selected]) #action-icon::after {
+    background-color: rgb(235, 235, 235);
+  }
+}
diff --git a/ui/webui/resources/cr_components/searchbox/searchbox_match.css b/ui/webui/resources/cr_components/searchbox/searchbox_match.css
index 4a5a750..935c95f 100644
--- a/ui/webui/resources/cr_components/searchbox/searchbox_match.css
+++ b/ui/webui/resources/cr_components/searchbox/searchbox_match.css
@@ -630,3 +630,65 @@
     --color-searchbox-results-dim-selected: rgb(255, 255, 255);
   }
 }
+
+/* Alerse: the command bar on a light theme: the dark theme's greys turned
+ * over, the selected row's tiles dark where that theme's are white. */
+@media (prefers-color-scheme: light) {
+  :host([is-top-chrome-searchbox_]) .container #remove:not([hidden]) {
+    --cr-icon-button-fill-color: rgb(115, 115, 115);
+  }
+
+  :host([is-top-chrome-searchbox_]) cr-searchbox-action:is([icon-path*='tab'], [icon-path*='switch']) {
+    --color-searchbox-results-action-chip-icon: rgb(120, 120, 120);
+    color: rgb(120, 120, 120);
+  }
+
+  :host([is-top-chrome-searchbox_][selected]) cr-searchbox-action:is([icon-path*='tab'], [icon-path*='switch']) {
+    --color-searchbox-results-action-chip-icon: rgb(0, 0, 0);
+    color: rgb(0, 0, 0);
+  }
+
+  :host([is-top-chrome-searchbox_]) #primaryText {
+    color: rgb(46, 46, 46);
+  }
+
+  :host([is-top-chrome-searchbox_][selected]) #primaryText {
+    color: rgb(0, 0, 0);
+  }
+
+  :host([is-top-chrome-searchbox_]) .alerse-action cr-searchbox-icon {
+    --color-searchbox-answer-icon-background: rgb(218, 218, 218);
+    --color-searchbox-answer-icon-foreground: rgb(74, 74, 74);
+  }
+
+  :host([is-top-chrome-searchbox_][selected]) .alerse-action cr-searchbox-icon {
+    --color-searchbox-answer-icon-background: rgb(30, 30, 30);
+    --color-searchbox-answer-icon-foreground: rgb(235, 235, 235);
+  }
+
+  :host([is-top-chrome-searchbox_]) #alerseShortcut {
+    background-color: rgb(218, 218, 218);
+    color: rgb(74, 74, 74);
+  }
+
+  :host([is-top-chrome-searchbox_][selected]) #alerseShortcut {
+    background-color: rgb(30, 30, 30);
+    color: rgb(235, 235, 235);
+  }
+
+  :host([is-top-chrome-searchbox_]) #secondaryText,
+  :host([is-top-chrome-searchbox_]) #secondaryText .url,
+  :host([is-top-chrome-searchbox_]) #secondaryText span {
+    color: rgb(120, 120, 120);
+  }
+
+  :host([is-top-chrome-searchbox_][selected]) #secondaryText,
+  :host([is-top-chrome-searchbox_][selected]) #secondaryText .url,
+  :host([is-top-chrome-searchbox_][selected]) #secondaryText span {
+    color: rgb(90, 90, 90);
+  }
+
+  :host([is-top-chrome-searchbox_][selected]) cr-searchbox-icon {
+    --color-searchbox-results-dim-selected: rgb(0, 0, 0);
+  }
+}
