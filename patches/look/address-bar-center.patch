+void LocationBarView::UpdateArcomiumAlignment() {
+  if (omnibox_view_) {
+    omnibox_view_->SetHorizontalAlignment(
+        arcomium_compact_ && !omnibox_view_->HasFocus() ? gfx::ALIGN_CENTER
+                                                        : gfx::ALIGN_LEFT);
+  }
+}
+
 void LocationBarView::SetArcomiumHovered(bool hovered) {
   if (arcomium_hovered_ == hovered) {
     return;
@@ -2190,6 +2199,7 @@ const LocationBarModel* LocationBarView::GetLocationBarModel() const {
 }
 
 void LocationBarView::OnOmniboxFocused() {
+  UpdateArcomiumAlignment();
   if (views::FocusRing::Get(this)) {
     views::FocusRing::Get(this)->Refresh();
   }
@@ -2214,6 +2224,7 @@ void LocationBarView::OpenOmniboxPopup(bool query_zps) {
 }
 
 void LocationBarView::OnOmniboxBlurred() {
+  UpdateArcomiumAlignment();
   if (views::FocusRing::Get(this)) {
     views::FocusRing::Get(this)->Refresh();
   }
