+// Arcomium: Arc for macOS shows its window controls as grey discs ringed in
+// their colors, and in color only while the pointer is over them. This view
+// draws that look over the buttons, which turn transparent meanwhile; clicks
+// go through to them.
+@interface ArcomiumWindowControlsMask : NSView
+@property(nonatomic) BOOL hovered;
+- (void)update;
+@end
+
+@implementation ArcomiumWindowControlsMask {
+  NSTrackingArea* __strong _trackingArea;
+}
+
+- (NSView*)hitTest:(NSPoint)point {
+  return nil;
+}
+
+- (void)updateTrackingAreas {
+  [super updateTrackingAreas];
+  if (_trackingArea) {
+    [self removeTrackingArea:_trackingArea];
+  }
+  _trackingArea = [[NSTrackingArea alloc]
+      initWithRect:NSZeroRect
+           options:NSTrackingMouseEnteredAndExited | NSTrackingActiveAlways |
+                   NSTrackingInVisibleRect
+             owner:self
+          userInfo:nil];
+  [self addTrackingArea:_trackingArea];
+}
+
+- (void)mouseEntered:(NSEvent*)event {
+  self.hovered = YES;
+  [self update];
+}
+
+- (void)mouseExited:(NSEvent*)event {
+  self.hovered = NO;
+  [self update];
+}
+
+// The buttons show themselves only under the pointer, or when this view
+// is hidden. Never quite transparent: AppKit disables a button at alpha 0,
+// and with it File > Close Window.
+- (void)update {
+  const BOOL masked = !self.hidden && !self.hovered;
+  for (NSWindowButton type : {NSWindowCloseButton, NSWindowMiniaturizeButton,
+                              NSWindowZoomButton}) {
+    [self.window standardWindowButton:type].alphaValue = masked ? 0.02 : 1.0;
+  }
+  [self setNeedsDisplay:YES];
+}
+
+- (void)drawRect:(NSRect)dirtyRect {
+  if (self.hovered) {
+    return;
+  }
+  NSWindow* window = self.window;
+  // The rings, in sRGB that the screen shows as Arc's #592F2A, #5F4E0F and
+  // #2A4D10 (AppKit matches these views' colors to the display; the page's
+  // pixels are not).
+  const struct {
+    NSWindowButton type;
+    uint32_t ring;
+  } kButtons[] = {{NSWindowCloseButton, 0x5F2C28},
+                  {NSWindowMiniaturizeButton, 0x624E02},
+                  {NSWindowZoomButton, 0x224E06}};
+  for (const auto& b : kButtons) {
+    NSButton* button = [window standardWindowButton:b.type];
+    if (!button || button.hidden) {
+      continue;
+    }
+    // The 14 pt disc inside the button, as AppKit draws it.
+    NSRect frame = [self convertRect:button.bounds fromView:button];
+    const CGFloat d = 14;
+    NSRect disc =
+        NSMakeRect(NSMidX(frame) - d / 2, NSMidY(frame) - d / 2, d, d);
+    [[NSColor colorWithSRGBRed:((b.ring >> 16) & 0xFF) / 255.0
+                         green:((b.ring >> 8) & 0xFF) / 255.0
+                          blue:(b.ring & 0xFF) / 255.0
+                         alpha:1] setFill];
+    [[NSBezierPath bezierPathWithOvalInRect:disc] fill];
+    // Arc's zoom button shows its grey face as a narrower oval, 9 x 11 pt.
+    NSRect face = b.type == NSWindowZoomButton
+                      ? NSInsetRect(disc, 2.5, 1.5)
+                      : NSInsetRect(disc, 1, 1);
+    [[NSColor colorWithSRGBRed:0x60 / 255.0
+                         green:0x60 / 255.0
+                          blue:0x5D / 255.0
+                         alpha:1] setFill];
+    [[NSBezierPath bezierPathWithOvalInRect:face] fill];
+  }
+}
+
 @end
 
