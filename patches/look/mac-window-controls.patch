+// Arcomium: Arc for macOS' zoom button sits 21.5 pt after the minimize
+// button, 1.5 pt closer than AppKit puts it.
+- (NSPoint)_zoomButtonOrigin {
+  NSPoint origin = [super _zoomButtonOrigin];
+  if (!_inFullScreen) {
+    origin.x -= 1.5;
+  }
+  return origin;
+}
+
+// The other two buttons follow the close button.
+- (NSPoint)_closeButtonOrigin {
+  NSPoint origin = [super _closeButtonOrigin];
+  if (_arcomiumFloating && !_inFullScreen) {
+    origin.x += 5;
+    origin.y -= 5;
+  }
+  return origin;
+}
+
+- (void)setArcomiumFloatingControls:(BOOL)floating {
+  if (_arcomiumFloating != floating) {
+    _arcomiumFloating = floating;
+    if ([self respondsToSelector:@selector(_updateButtonPositions)]) {
+      [self _updateButtonPositions];
+    }
+    [self setNeedsLayout:YES];
+  }
+  [self updateArcomiumMask];
+}
+
+- (void)updateArcomiumMask {
+  NSButton* close = [self.window standardWindowButton:NSWindowCloseButton];
+  NSButton* zoom = [self.window standardWindowButton:NSWindowZoomButton];
+  NSView* parent = close.superview;
+  if (!close || !zoom || !parent || zoom.superview != parent) {
+    return;
+  }
+  if (!_arcomiumMask) {
+    _arcomiumMask = [[ArcomiumWindowControlsMask alloc] init];
+  }
+  if (_arcomiumMask.superview != parent ||
+      parent.subviews.lastObject != _arcomiumMask) {
+    [parent addSubview:_arcomiumMask positioned:NSWindowAbove relativeTo:nil];
+  }
+  _arcomiumMask.frame = NSUnionRect(close.frame, zoom.frame);
+  _arcomiumMask.hidden = _inFullScreen || close.hidden;
+  [_arcomiumMask update];
+}
