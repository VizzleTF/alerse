+// Alerse: full screen shows the bare page.
+void MultiContentsView::SetAlerseBarePage(bool bare) {
+  if (alerse_bare_page_ == bare) {
+    return;
+  }
+  alerse_bare_page_ = bare;
+  UpdateContentsBorderAndOverlay();
+  background_view_->SchedulePaint();
+}
