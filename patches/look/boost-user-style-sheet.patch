+// Alerse: one key, so that each Boost sheet replaces the one before it.
+void ChromeRenderFrameObserver::SetAlerseBoostCss(const std::string& css) {
+  blink::WebDocument document = render_frame()->GetWebFrame()->GetDocument();
+  const blink::WebStyleSheetKey key = WebString::FromAscii("alerse-boost");
+  document.RemoveInsertedStyleSheet(key, blink::WebCssOrigin::kUser);
+  if (!css.empty()) {
+    document.InsertStyleSheet(WebString::FromUtf8(css), &key,
+                              blink::WebCssOrigin::kUser);
+  }
+}
