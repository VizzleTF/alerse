+    views::View* starting_from,
+    bool is_visible) {
+  ScheduleUpdateExtensions();
+}
+
+void VerticalTabStripTopContainer::ChildPreferredSizeChanged(
+    views::View* child) {
+  // Pinning or unpinning an extension changes how much room they need.
+  InvalidateLayout();
+}
+
+void VerticalTabStripTopContainer::OnViewIsDeleting(
+    views::View* observed_view) {
+  arc_extensions_placeholder_observation_.Reset();
+  arc_extensions_placeholder_ = nullptr;
+}
+
+void VerticalTabStripTopContainer::ScheduleUpdateExtensions() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&VerticalTabStripTopContainer::UpdateExtensions,
+                                arc_weak_factory_.GetWeakPtr()));
+}
+
+void VerticalTabStripTopContainer::UpdateExtensions() {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  ToolbarView* toolbar = browser_view ? browser_view->toolbar() : nullptr;
+  const bool take = arc_logo_button_ && GetWidget() && IsDrawn() && toolbar &&
+                    !browser_view->IsToolbarVisible();
+  if (!take) {
+    ReturnExtensions();
+    return;
+  }
+  ExtensionsToolbarDesktop* extensions = toolbar->extensions_container();
+  if (arc_extensions_ || !extensions || extensions->parent() != toolbar) {
+    return;
+  }
+  // The toolbar keeps their place while they are here. Not their flex rule:
+  // it asks their own animating layout manager, which a placeholder has not.
+  arc_extensions_placeholder_ = toolbar->AddChildViewAt(
+      std::make_unique<views::View>(), *toolbar->GetIndexOf(extensions));
+  arc_extensions_placeholder_observation_.Observe(arc_extensions_placeholder_);
+  arc_extensions_ = AddChildView(extensions);
+  extensions->SetAlerseCompact(true);
+  // In the frame's color, opaque: their labels (a site access request, say)
+  // render subpixel text, which needs an opaque background under it.
+  extensions->SetBackground(views::CreateSolidBackground(ui::kColorFrameActive));
+  InvalidateLayout();
+}
+
+void VerticalTabStripTopContainer::ReturnExtensions() {
+  if (!arc_extensions_) {
+    return;
+  }
+  auto* extensions = static_cast<ExtensionsToolbarDesktop*>(
+      arc_extensions_.get());
+  arc_extensions_ = nullptr;
+  views::View* placeholder = arc_extensions_placeholder_;
+  views::View* toolbar = placeholder ? placeholder->parent() : nullptr;
+  arc_extensions_placeholder_observation_.Reset();
+  arc_extensions_placeholder_ = nullptr;
+  // Without a placeholder the toolbar is going with the window.
+  if (!toolbar) {
+    return;
+  }
+  extensions->SetAlerseCompact(false);
+  extensions->SetBackground(nullptr);
+  toolbar->AddChildViewAt(extensions, *toolbar->GetIndexOf(placeholder));
+  toolbar->RemoveChildViewT(placeholder);
+}
