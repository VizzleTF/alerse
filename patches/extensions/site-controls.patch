+void ExtensionsToolbarButton::ToggleArcomiumSiteControls(views::View* anchor) {
+  if (arcomium_site_controls::IsShowing()) {
+    arcomium_site_controls::Hide();
+    return;
+  }
+  if (extensions_menu_coordinator_ &&
+      extensions_menu_coordinator_->IsShowing()) {
+    extensions_menu_coordinator_->Hide();
+  } else if (ExtensionsMenuView::IsShowing()) {
+    ExtensionsMenuView::Hide();
+  }
+  extension_menu_observation_.Reset();
+  pressed_lock_ = menu_button_controller_->TakeLock();
+  extensions_toolbar_->OnMenuOpening();
+  views::Widget* widget =
+      arcomium_site_controls::Show(anchor ? anchor : this, browser_,
+                                   extensions_toolbar_);
+  extensions_menu_widget_ = widget->GetWeakPtr();
+  extension_menu_observation_.Observe(widget);
+}
+
 bool ExtensionsToolbarButton::GetExtensionsMenuShowing() const {
   return pressed_lock_.get();
 }
