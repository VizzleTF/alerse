+void LocationBarView::ShowArcomiumSiteControls() {
+  // Arc's site controls, as the extensions button opens them; without that
+  // button, Chrome's page info.
+  BrowserView* browser_view =
+      browser_ ? BrowserView::GetBrowserViewForBrowser(browser_) : nullptr;
+  ExtensionsToolbarDesktop* extensions =
+      browser_view && browser_view->toolbar()
+          ? browser_view->toolbar()->extensions_container()
+          : nullptr;
+  if (extensions && extensions->GetExtensionsButton()) {
+    extensions->GetExtensionsButton()->ToggleArcomiumSiteControls();
+    return;
+  }
+  ShowPageInfoDialog();
+}
