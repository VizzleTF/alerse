 namespace {
 
+// Arcomium: the Chrome Web Store keeps its own "Add to Chrome" button off in
+// browsers it does not take for Chrome, so the app menu offers the install on
+// an item's page. Not in chrome_command_ids.h: only this menu handles it.
+constexpr int kArcomiumAddFromWebstore = 40391;
+
+// The extension id of the Chrome Web Store item page shown in `browser`, or
+// "" on any other page.
+std::string GetWebstoreItemId(BrowserWindowInterface* browser) {
+  content::WebContents* contents =
+      browser->GetTabStripModel()->GetActiveWebContents();
+  if (!contents) {
+    return std::string();
+  }
+  const GURL& url = contents->GetLastCommittedURL();
+  if (url.host() != extension_urls::GetNewWebstoreLaunchURL().host()) {
+    return std::string();
+  }
+  const std::string_view path = url.path();
+  const size_t slash = path.rfind('/');
+  const std::string id(slash == std::string_view::npos ? path
+                                                       : path.substr(slash + 1));
+  return crx_file::id_util::IdIsValid(id) ? id : std::string();
+}
