+void ArcomiumAddressBar::TakeExtensions(views::View* toolbar) {
+  ToolbarView* toolbar_view = static_cast<ToolbarView*>(toolbar);
+  views::View* extensions = toolbar_view->extensions_container();
+  if (extensions_ || !extensions || extensions->parent() != toolbar) {
+    return;
+  }
+  // The toolbar keeps their place while they are here.
+  auto placeholder = std::make_unique<views::View>();
+  if (const views::FlexSpecification* flex =
+          extensions->GetProperty(views::kFlexBehaviorKey)) {
+    placeholder->SetProperty(views::kFlexBehaviorKey, *flex);
+  }
+  extensions_placeholder_ = toolbar->AddChildViewAt(
+      std::move(placeholder), *toolbar->GetIndexOf(extensions));
+  extensions_placeholder_observation_.Observe(extensions_placeholder_);
+  extensions_ = AddChildView(extensions);
+}
+
+void ArcomiumAddressBar::ReturnExtensions() {
+  if (!extensions_) {
+    return;
+  }
+  views::View* extensions = extensions_;
+  extensions_ = nullptr;
+  views::View* placeholder = extensions_placeholder_;
+  views::View* toolbar = placeholder ? placeholder->parent() : nullptr;
+  extensions_placeholder_observation_.Reset();
+  extensions_placeholder_ = nullptr;
+  // Without a placeholder the toolbar is going with the window; they stay and
+  // go with it too.
+  if (!toolbar) {
+    return;
+  }
+  toolbar->AddChildViewAt(extensions, *toolbar->GetIndexOf(placeholder));
+  toolbar->RemoveChildViewT(placeholder);
+}
+
 void ArcomiumAddressBar::ReturnLocationBar() {
   if (!location_bar_) {
     return;
   }
   StopEditing();
+  ReturnExtensions();
   LocationBarView* location_bar = location_bar_;
   location_bar_ = nullptr;
   location_bar->SetArcomiumCompact(false);
