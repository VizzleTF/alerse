+// Alerse: the password is kept in a file readable only by the user, as
+// macOS asks for the login keychain password after every update of an app
+// without an Apple Team ID: the keychain item's access goes by the build's
+// code hash. A new install never touches the keychain; one from before
+// 0.1.22 takes the keychain's password once, as its data is encrypted with
+// it.
+base::FilePath AlersePasswordFile() {
+  return base::apple::GetUserLibraryPath()
+      .Append("Application Support")
+      .Append("Alerse")
+      .Append("Safe Storage Key");
+}
+
+std::string ReadAlersePasswordFile() {
+  std::string password;
+  if (!base::ReadFileToStringWithMaxSize(AlersePasswordFile(), &password,
+                                         1024)) {
+    return std::string();
+  }
+  return std::string(base::TrimWhitespaceASCII(password, base::TRIM_ALL));
+}
+
+void WriteAlersePasswordFile(const std::string& password) {
+  const base::FilePath file = AlersePasswordFile();
+  const base::FilePath temp = file.AddExtension("new");
+  if (!base::CreateDirectory(file.DirName()) || !base::WriteFile(temp, "") ||
+      !base::SetPosixFilePermissions(temp, 0600) ||
+      !base::WriteFile(temp, password) || !base::Move(temp, file)) {
+    base::DeleteFile(temp);
+    LOG(ERROR) << "Alerse: could not save the Safe Storage key file";
+  }
+}
+
+// Whether the keychain has the item, by its attributes only: reading them
+// does not ask for the keychain password, as reading its data does.
+bool AlerseKeychainHasItem(KeychainV2& keychain,
+                           const std::string& service_name,
+                           const std::string& account_name) {
+  base::apple::ScopedCFTypeRef<CFStringRef> service(
+      base::SysUTF8ToCFStringRef(service_name));
+  base::apple::ScopedCFTypeRef<CFStringRef> account(
+      base::SysUTF8ToCFStringRef(account_name));
+  const void* keys[] = {kSecClass, kSecAttrService, kSecAttrAccount,
+                        kSecReturnAttributes, kSecMatchLimit};
+  const void* values[] = {kSecClassGenericPassword, service.get(),
+                          account.get(), kCFBooleanTrue, kSecMatchLimitOne};
+  base::apple::ScopedCFTypeRef<CFDictionaryRef> query(CFDictionaryCreate(
+      nullptr, keys, values, std::size(keys), &kCFTypeDictionaryKeyCallBacks,
+      &kCFTypeDictionaryValueCallBacks));
+  base::apple::ScopedCFTypeRef<CFTypeRef> result;
+  return keychain.ItemCopyMatching(query.get(), result.InitializeInto()) !=
+         errSecItemNotFound;
+}
