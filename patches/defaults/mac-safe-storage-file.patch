+// Alerse: the password is kept in a file readable only by the user, as
+// macOS asks for the login keychain password after every update of an app
+// without an Apple Team ID: the keychain item's access goes by the build's
+// code hash. The first run takes the keychain's password once.
+base::FilePath AlersePasswordFile() {
+  return base::apple::GetUserLibraryPath()
+      .Append("Application Support")
+      .Append("Alerse")
+      .Append("Safe Storage Key");
+}
+
+std::string ReadAlersePasswordFile() {
+  std::string password;
+  if (!base::ReadFileToStringWithMaxSize(AlersePasswordFile(), &password,
+                                         1024)) {
+    return std::string();
+  }
+  return std::string(base::TrimWhitespaceASCII(password, base::TRIM_ALL));
+}
+
+void WriteAlersePasswordFile(const std::string& password) {
+  const base::FilePath file = AlersePasswordFile();
+  const base::FilePath temp = file.AddExtension("new");
+  if (!base::CreateDirectory(file.DirName()) || !base::WriteFile(temp, "") ||
+      !base::SetPosixFilePermissions(temp, 0600) ||
+      !base::WriteFile(temp, password) || !base::Move(temp, file)) {
+    base::DeleteFile(temp);
+    LOG(ERROR) << "Alerse: could not save the Safe Storage key file";
+  }
+}
