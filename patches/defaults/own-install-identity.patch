diff --git a/chrome/install_static/user_data_dir.cc b/chrome/install_static/user_data_dir.cc
index 6b231841bf6..bab70225029 100644
--- a/chrome/install_static/user_data_dir.cc
+++ b/chrome/install_static/user_data_dir.cc
@@ -76,6 +76,95 @@ bool GetUserDataDirectoryUsingProcessCommandLine(
 // TODO(ananta)
 // http://crbug.com/604923
 // Unify this with the Browser Distribution code.
+// Arcomium: whether `dir` holds a browser profile: it has a Local State.
+bool HasProfile(const std::wstring& dir) {
+  return ::GetFileAttributesW((dir + L"\\Local State").c_str()) !=
+         INVALID_FILE_ATTRIBUTES;
+}
+
+// Arcomium: whether `dir` holds an Arcomium profile: its default profile's
+// preferences have Arcomium's own member.
+bool IsArcomiumProfile(const std::wstring& dir) {
+  const std::wstring prefs = dir + L"\\Default\\Preferences";
+  HANDLE file = ::CreateFileW(prefs.c_str(), GENERIC_READ,
+                              FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+                              OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return false;
+  }
+  std::string text;
+  char buffer[64 * 1024];
+  DWORD read = 0;
+  while (text.size() < 16 * 1024 * 1024 &&
+         ::ReadFile(file, buffer, sizeof(buffer), &read, nullptr) && read) {
+    text.append(buffer, read);
+  }
+  ::CloseHandle(file);
+  return text.find("\"arcomium\":") != std::string::npos;
+}
+
+// Arcomium: whether a running browser has `dir` open: it holds its lockfile
+// (ProcessSingleton) without sharing it.
+bool ProfileInUse(const std::wstring& dir) {
+  HANDLE file = ::CreateFileW((dir + L"\\lockfile").c_str(), GENERIC_READ, 0,
+                              nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL,
+                              nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return ::GetLastError() == ERROR_SHARING_VIOLATION;
+  }
+  ::CloseHandle(file);
+  return false;
+}
+
+// Arcomium: Alerse takes over the profile of the browser it was before:
+// "Arcomium\User Data" (0.1.2 to 0.1.7), or "Chromium\User Data", where
+// versions before Arcomium had its own identity kept it (only if it is
+// Arcomium's). The first start without a profile of its own moves that
+// directory here. A profile another browser has open is not moved but used
+// where it is, so nothing is lost; the move happens at a later start. This
+// runs only for the default directory, never with --user-data-dir.
+void TakeOverOldUserDataDir(std::wstring* user_data_dir) {
+  if (HasProfile(*user_data_dir)) {
+    return;
+  }
+  const std::wstring suffix = L"\\Alerse\\User Data";
+  if (user_data_dir->size() <= suffix.size() ||
+      user_data_dir->compare(user_data_dir->size() - suffix.size(),
+                             suffix.size(), suffix) != 0) {
+    return;
+  }
+  const std::wstring base =
+      user_data_dir->substr(0, user_data_dir->size() - suffix.size());
+  const std::wstring arcomium = base + L"\\Arcomium\\User Data";
+  const std::wstring chromium = base + L"\\Chromium\\User Data";
+  std::wstring legacy;
+  if (HasProfile(arcomium)) {
+    legacy = arcomium;
+  } else if (HasProfile(chromium) && IsArcomiumProfile(chromium)) {
+    legacy = chromium;
+  } else {
+    return;
+  }
+  if (ProfileInUse(legacy)) {
+    *user_data_dir = legacy;
+    return;
+  }
+  ::CreateDirectoryW((base + L"\\Alerse").c_str(), nullptr);
+  // A directory without a profile goes if it is empty, or else is kept aside
+  // under another name.
+  if (::GetFileAttributesW(user_data_dir->c_str()) !=
+          INVALID_FILE_ATTRIBUTES &&
+      !::RemoveDirectoryW(user_data_dir->c_str()) &&
+      !::MoveFileExW(user_data_dir->c_str(),
+                     (*user_data_dir + L".old").c_str(), 0)) {
+    *user_data_dir = legacy;
+    return;
+  }
+  if (!::MoveFileExW(legacy.c_str(), user_data_dir->c_str(), 0)) {
+    *user_data_dir = legacy;
+  }
+}
