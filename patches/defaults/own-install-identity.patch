 namespace chrome {
 
 using base::nix::GetXDGDirectory;
@@ -95,9 +99,39 @@ bool GetDefaultUserDataDirectory(base::FilePath* result) {
 #elif BUILDFLAG(GOOGLE_CHROME_BRANDING)
   std::string data_dir_basename = "google-chrome";
 #else
-  std::string data_dir_basename = "chromium";
+  // Arcomium: its own directory, apart from Chromium's.
+  std::string data_dir_basename = "arcomium";
 #endif
   *result = config_dir.Append(data_dir_basename + GetChannelSuffixForDataDir());
+#if !BUILDFLAG(GOOGLE_CHROME_BRANDING)
+  // Arcomium: before it had its own identity, Arcomium kept its profile in
+  // ~/.config/chromium. The first start without ~/.config/arcomium moves that
+  // profile there if it is Arcomium's; if it cannot be moved, it is used
+  // where it is. Plain POSIX calls: this runs before blocking calls are
+  // checked.
+  struct stat info;
+  if (stat(result->value().c_str(), &info) != 0) {
+    const base::FilePath legacy =
+        config_dir.Append("chromium" + GetChannelSuffixForDataDir());
+    const std::string prefs =
+        legacy.Append("Default").Append("Preferences").value();
+    const int fd = open(prefs.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd >= 0) {
+      std::string text;
+      char buffer[64 * 1024];
+      ssize_t size;
+      while (text.size() < 16 * 1024 * 1024 &&
+             (size = read(fd, buffer, sizeof(buffer))) > 0) {
+        text.append(buffer, static_cast<size_t>(size));
+      }
+      close(fd);
+      if (text.find("\"arcomium\":") != std::string::npos &&
+          rename(legacy.value().c_str(), result->value().c_str()) != 0) {
+        *result = legacy;
+      }
+    }
+  }
+#endif
   return true;
 }
 
