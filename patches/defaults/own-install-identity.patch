diff --git a/chrome/install_static/user_data_dir.cc b/chrome/install_static/user_data_dir.cc
index 6b231841bf6..a07e01904a9 100644
--- a/chrome/install_static/user_data_dir.cc
+++ b/chrome/install_static/user_data_dir.cc
@@ -76,6 +76,55 @@ bool GetUserDataDirectoryUsingProcessCommandLine(
 // TODO(ananta)
 // http://crbug.com/604923
 // Unify this with the Browser Distribution code.
+// Arcomium: whether `dir` holds an Arcomium profile: its default profile's
+// preferences have Arcomium's own member.
+bool IsArcomiumProfile(const std::wstring& dir) {
+  const std::wstring prefs = dir + L"\\Default\\Preferences";
+  HANDLE file = ::CreateFileW(prefs.c_str(), GENERIC_READ,
+                              FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+                              OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return false;
+  }
+  std::string text;
+  char buffer[64 * 1024];
+  DWORD read = 0;
+  while (text.size() < 16 * 1024 * 1024 &&
+         ::ReadFile(file, buffer, sizeof(buffer), &read, nullptr) && read) {
+    text.append(buffer, read);
+  }
+  ::CloseHandle(file);
+  return text.find("\"arcomium\":") != std::string::npos;
+}
+
+// Arcomium: before it had its own identity, Arcomium kept its profile in
+// "Chromium\User Data". The first start without "Arcomium\User Data" moves
+// that profile here if it is Arcomium's. If it cannot be moved (an older
+// Arcomium still has it open), it is used where it is: nothing is lost.
+void MaybeUseArcomiumLegacyUserDataDir(std::wstring* user_data_dir) {
+  if (::GetFileAttributesW(user_data_dir->c_str()) !=
+      INVALID_FILE_ATTRIBUTES) {
+    return;
+  }
+  const std::wstring suffix = L"\\Arcomium\\User Data";
+  if (user_data_dir->size() <= suffix.size() ||
+      user_data_dir->compare(user_data_dir->size() - suffix.size(),
+                             suffix.size(), suffix) != 0) {
+    return;
+  }
+  const std::wstring base =
+      user_data_dir->substr(0, user_data_dir->size() - suffix.size());
+  const std::wstring legacy = base + L"\\Chromium\\User Data";
+  if (!IsArcomiumProfile(legacy)) {
+    return;
+  }
+  ::CreateDirectoryW((base + L"\\Arcomium").c_str(), nullptr);
+  if (::MoveFileExW(legacy.c_str(), user_data_dir->c_str(), 0)) {
+    return;
+  }
+  *user_data_dir = legacy;
+}
+
 bool GetDefaultUserDataDirectory(const InstallConstants& mode,
                                  std::wstring* result) {
   // This environment variable should be set on Windows Vista and later
@@ -100,6 +149,7 @@ bool GetDefaultUserDataDirectory(const InstallConstants& mode,
   AppendChromeInstallSubDirectory(mode, true /* include_suffix */, result);
   result->push_back(L'\\');
   result->append(L"User Data");
+  MaybeUseArcomiumLegacyUserDataDir(result);
   return true;
 }
 
