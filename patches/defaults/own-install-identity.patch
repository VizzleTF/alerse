@@ -100,6 +189,7 @@ bool GetDefaultUserDataDirectory(const InstallConstants& mode,
   AppendChromeInstallSubDirectory(mode, true /* include_suffix */, result);
   result->push_back(L'\\');
   result->append(L"User Data");
