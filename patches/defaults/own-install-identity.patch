+      !base::CommandLine::ForCurrentProcess()->HasSwitch("type");
+  if (default_dir_in_use && !HasProfile(*result)) {
+    const base::FilePath arcomium =
+        config_dir.Append("arcomium" + GetChannelSuffixForDataDir());
+    const base::FilePath chromium =
