+  for (const PrepopulatedEngine* engine :
+       {&TemplateURLPrepopulateData::duckduckgo,
+        &TemplateURLPrepopulateData::brave,
+        &TemplateURLPrepopulateData::startpage,
+        &TemplateURLPrepopulateData::ecosia,
