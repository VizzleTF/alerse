+// Alerse: the Chrome Web Store switch.
+bool g_alerse_web_store_on = false;
+
+base::RepeatingCallback<void(bool)>& AlerseWebStoreObserver() {
+  static base::NoDestructor<base::RepeatingCallback<void(bool)>> observer;
+  return *observer;
+}
+
 }  // namespace
 
+bool IsAlerseWebStoreOn() {
+  return g_alerse_web_store_on;
+}
+
+void SetAlerseWebStoreOn(bool on) {
+  if (g_alerse_web_store_on == on) {
+    return;
+  }
+  g_alerse_web_store_on = on;
+  if (AlerseWebStoreObserver()) {
+    AlerseWebStoreObserver().Run(on);
+  }
+}
+
+void SetAlerseWebStoreObserver(base::RepeatingCallback<void(bool)> observer) {
+  AlerseWebStoreObserver() = std::move(observer);
+}
+
 // Alerse installs and updates extensions from the Chrome Web Store, so its
 // URLs stay real: the literals are split so that ungoogled-chromium's domain
 // substitution leaves them alone.
