 namespace chrome {
 
+// Alerse: Alerse (CrProductDirName "Alerse") takes over the profile of the
+// browser it was before: "Arcomium" (0.1.0 to 0.1.7), or "Chromium", where
+// versions before Arcomium had its own bundle ID kept it beside Chromium's
+// and ungoogled-chromium's (only if it is Arcomium's: its preferences have
+// Arcomium's own member). The first start without a profile of its own moves
+// that directory to "Alerse". A profile another browser has open (its
+// SingletonLock names a live process) is not moved but used where it is, so
+// that browser keeps its windows; the move happens at a later start. Only the
+// browser process that uses the default directory moves anything: never with
+// --user-data-dir (test and development runs), which still asks for the
+// default directory (crash reports live there). Plain POSIX calls: this runs
+// before the browser allows blocking calls to be checked.
+namespace {
+
+bool PathExists(const std::string& path) {
+  struct stat info;
+  return lstat(path.c_str(), &info) == 0;
+}
+
+// Whether `dir` holds a browser profile: it has a Local State.
+bool HasProfile(const base::FilePath& dir) {
+  return PathExists(dir.Append("Local State").value());
+}
+
+// Whether `dir` is Arcomium's: its default profile's preferences are a JSON
+// object with an "arcomium" member.
+bool IsAlerseLineProfile(const base::FilePath& dir) {
+  const std::string prefs =
+      dir.Append("Default").Append("Preferences").value();
+  const int fd = open(prefs.c_str(), O_RDONLY | O_CLOEXEC);
+  if (fd < 0) {
+    return false;
+  }
+  std::string text;
+  char buffer[64 * 1024];
+  ssize_t read_size;
+  while (text.size() < 16 * 1024 * 1024 &&
+         (read_size = read(fd, buffer, sizeof(buffer))) > 0) {
+    text.append(buffer, static_cast<size_t>(read_size));
+  }
+  close(fd);
+  return text.find("\"arcomium\":") != std::string::npos;
+}
+
+// Whether a running browser has `dir` open: its SingletonLock is a symlink to
+// "hostname-pid" of a live process.
+bool ProfileInUse(const base::FilePath& dir) {
+  char target[256];
+  const ssize_t size = readlink(dir.Append("SingletonLock").value().c_str(),
+                                target, sizeof(target) - 1);
+  if (size <= 0) {
+    return false;
+  }
+  target[size] = '\0';
+  const char* dash = strrchr(target, '-');
+  const long pid = dash ? strtol(dash + 1, nullptr, 10) : 0;
+  return pid <= 0 || kill(static_cast<pid_t>(pid), 0) == 0 || errno == EPERM;
+}
+
+void TakeOverOldProfile(base::FilePath* user_data_dir) {
+  if (user_data_dir->BaseName().value() != "Alerse" ||
+      !base::CommandLine::InitializedForCurrentProcess()) {
+    return;
+  }
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch("user-data-dir") ||
+      command_line.HasSwitch("type") || HasProfile(*user_data_dir)) {
+    return;
+  }
+  const base::FilePath arcomium = user_data_dir->DirName().Append("Arcomium");
+  const base::FilePath chromium = user_data_dir->DirName().Append("Chromium");
+  base::FilePath old_dir;
+  if (HasProfile(arcomium)) {
+    old_dir = arcomium;
+  } else if (HasProfile(chromium) && IsAlerseLineProfile(chromium)) {
+    old_dir = chromium;
+  } else {
+    return;
+  }
+  if (ProfileInUse(old_dir)) {
+    *user_data_dir = old_dir;
+    return;
+  }
+  // A directory without a profile goes if it is empty, or else (crash
+  // reports of a development run) is kept aside under another name.
+  const std::string target = user_data_dir->value();
+  if (PathExists(target) && rmdir(target.c_str()) != 0) {
+    const std::string aside = target + ".old";
+    if (PathExists(aside) || rename(target.c_str(), aside.c_str()) != 0) {
+      *user_data_dir = old_dir;
+      return;
+    }
+  }
+  if (rename(old_dir.value().c_str(), target.c_str()) != 0) {
+    *user_data_dir = old_dir;
+  }
+}
+
+}  // namespace
+
 bool GetDefaultUserDataDirectory(base::FilePath* result) {
-  return GetDefaultUserDataDirectoryForProduct(ProductDirName(), result);
+  const bool success =
+      GetDefaultUserDataDirectoryForProduct(ProductDirName(), result);
+  if (success) {
+    TakeOverOldProfile(result);
+  }
+  return success;
 }
 
