+void AutoPictureInPictureTabHelper::OnSpaceHiddenChanged(bool hidden) {
+  if (space_hidden_ == hidden) {
+    return;
+  }
+  space_hidden_ = hidden;
+  if (!tab_observer_helper_->IsTabActivated()) {
+    return;
+  }
+  if (!hidden) {
+    MaybeExitAutoPictureInPicture();
+  } else if (!is_in_picture_in_picture_) {
+    MaybeEnterAutoPictureInPicture();
+    MaybeScheduleAsyncTasks();
+  }
+}
