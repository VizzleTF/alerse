+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_ARCOMIUM_MINI_PLAYER_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_ARCOMIUM_MINI_PLAYER_H_
+
+#include <optional>
