diff --git a/components/sync/service/arcomium_sync_account.cc b/components/sync/service/arcomium_sync_account.cc
new file mode 100644
index 0000000000..999edb90f5
--- /dev/null
+++ b/components/sync/service/arcomium_sync_account.cc
@@ -0,0 +1,148 @@
+// Copyright 2026 The Arcomium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/sync/service/arcomium_sync_account.h"
+
+#include <string_view>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/base64url.h"
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/logging.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/strings/string_number_conversions.h"
+#include "components/os_crypt/async/common/encryptor.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "third_party/boringssl/src/include/openssl/curve25519.h"
+#include "third_party/boringssl/src/include/openssl/digest.h"
+#include "third_party/boringssl/src/include/openssl/hkdf.h"
+
+namespace syncer {
+
+namespace {
+
+constexpr char kServerURLPref[] = "arcomium.sync.server_url";
+constexpr char kSecretPref[] = "arcomium.sync.secret";
+
+// For setting up a device by hand until the settings page exists. The secret
+// on a command line is visible to other programs of the user, so the switch
+// is for testing only.
+constexpr char kServerURLSwitch[] = "arcomium-sync-url";
+constexpr char kSecretSwitch[] = "arcomium-sync-secret";
+
+constexpr uint8_t kTokenVersion = 0x01;
+constexpr std::string_view kTokenContext = "arcomium-sync-token-v1";
+constexpr std::string_view kKdfSalt = "arcomium-sync";
+constexpr std::string_view kKeyInfo = "ed25519-key";
+constexpr std::string_view kPassphraseInfo = "nigori-passphrase";
+
+std::array<uint8_t, 32> Derive(base::span<const uint8_t> secret,
+                               std::string_view info) {
+  std::array<uint8_t, 32> out;
+  CHECK(HKDF(out.data(), out.size(), EVP_sha256(), secret.data(),
+             secret.size(), reinterpret_cast<const uint8_t*>(kKdfSalt.data()),
+             kKdfSalt.size(), reinterpret_cast<const uint8_t*>(info.data()),
+             info.size()));
+  return out;
+}
+
+}  // namespace
+
+// static
+void ArcomiumSyncAccount::RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterStringPref(kServerURLPref, std::string());
+  registry->RegisterStringPref(kSecretPref, std::string());
+}
+
+// static
+void ArcomiumSyncAccount::ApplyCommandLine(PrefService* prefs) {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch(kServerURLSwitch)) {
+    prefs->SetString(kServerURLPref,
+                     command_line.GetSwitchValueASCII(kServerURLSwitch));
+  }
+}
+
+// static
+GURL ArcomiumSyncAccount::GetServerURL(const PrefService& prefs) {
+  GURL url(prefs.GetString(kServerURLPref));
+  return url.is_valid() ? url : GURL();
+}
+
+// static
+std::optional<ArcomiumSyncAccount> ArcomiumSyncAccount::Load(
+    PrefService* prefs,
+    const os_crypt_async::Encryptor& encryptor) {
+  std::array<uint8_t, kSecretSize> secret;
+
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch(kSecretSwitch)) {
+    if (!base::HexStringToSpan(command_line.GetSwitchValueASCII(kSecretSwitch),
+                               secret)) {
+      LOG(ERROR) << "--" << kSecretSwitch << " needs 64 hex digits";
+      return std::nullopt;
+    }
+    std::string ciphertext;
+    if (!encryptor.EncryptString(
+            std::string(secret.begin(), secret.end()), &ciphertext)) {
+      LOG(ERROR) << "Cannot encrypt the Arcomium sync secret";
+      return std::nullopt;
+    }
+    prefs->SetString(kSecretPref, base::Base64Encode(ciphertext));
+    return ArcomiumSyncAccount(secret);
+  }
+
+  std::string ciphertext;
+  std::string plaintext;
+  if (!base::Base64Decode(prefs->GetString(kSecretPref), &ciphertext) ||
+      ciphertext.empty() || !encryptor.DecryptString(ciphertext, &plaintext) ||
+      plaintext.size() != kSecretSize) {
+    return std::nullopt;
+  }
+  base::span(secret).copy_from(base::as_byte_span(plaintext));
+  return ArcomiumSyncAccount(secret);
+}
+
+ArcomiumSyncAccount::ArcomiumSyncAccount(
+    const std::array<uint8_t, kSecretSize>& secret) {
+  const std::array<uint8_t, 32> seed = Derive(secret, kKeyInfo);
+  ED25519_keypair_from_seed(public_key_.data(), private_key_.data(),
+                            seed.data());
+  passphrase_ = base::Base64Encode(Derive(secret, kPassphraseInfo));
+}
+
+ArcomiumSyncAccount::ArcomiumSyncAccount(const ArcomiumSyncAccount&) = default;
+ArcomiumSyncAccount& ArcomiumSyncAccount::operator=(
+    const ArcomiumSyncAccount&) = default;
+ArcomiumSyncAccount::~ArcomiumSyncAccount() = default;
+
+std::string ArcomiumSyncAccount::MakeToken(base::Time now) const {
+  std::vector<uint8_t> token;
+  token.push_back(kTokenVersion);
+  token.insert(token.end(), public_key_.begin(), public_key_.end());
+  const auto issued_at = base::U64ToBigEndian(
+      static_cast<uint64_t>(now.InMillisecondsSinceUnixEpoch()));
+  token.insert(token.end(), issued_at.begin(), issued_at.end());
+
+  // Signed: the context, then the key and time (the token without its
+  // version byte).
+  std::vector<uint8_t> message(kTokenContext.begin(), kTokenContext.end());
+  message.insert(message.end(), token.begin() + 1, token.end());
+  std::array<uint8_t, 64> signature;
+  CHECK(ED25519_sign(signature.data(), message.data(), message.size(),
+                     private_key_.data()));
+  token.insert(token.end(), signature.begin(), signature.end());
+
+  std::string encoded;
+  base::Base64UrlEncode(token, base::Base64UrlEncodePolicy::OMIT_PADDING,
+                        &encoded);
+  return encoded;
+}
+
+}  // namespace syncer
diff --git a/components/sync/service/arcomium_sync_account.h b/components/sync/service/arcomium_sync_account.h
new file mode 100644
index 0000000000..7e61e0c60c
--- /dev/null
+++ b/components/sync/service/arcomium_sync_account.h
@@ -0,0 +1,75 @@
+// Copyright 2026 The Arcomium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_SYNC_SERVICE_ARCOMIUM_SYNC_ACCOUNT_H_
+#define COMPONENTS_SYNC_SERVICE_ARCOMIUM_SYNC_ACCOUNT_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "base/time/time.h"
+#include "url/gurl.h"
+
+class PrefRegistrySimple;
+class PrefService;
+
+namespace os_crypt_async {
+class Encryptor;
+}  // namespace os_crypt_async
+
+namespace syncer {
+
+// Arcomium syncs without a Google account. The devices of a sync chain share
+// a 32-byte secret, from which each derives the same Ed25519 key pair, which
+// is the chain's identity on the server, and the same custom passphrase,
+// which encrypts all data before it leaves the device.
+//
+// The server URL lives in prefs; the secret is kept encrypted with OSCrypt.
+// Sync runs in Chromium's local sync mode (no account, full sync) against the
+// server, with tokens signed by the chain's key as access tokens.
+class ArcomiumSyncAccount {
+ public:
+  static constexpr size_t kSecretSize = 32;
+
+  static void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+  // Copies --arcomium-sync-url into prefs. Call before SyncPrefs reads
+  // whether sync is enabled.
+  static void ApplyCommandLine(PrefService* prefs);
+
+  // The server's URL, or an empty one when the profile does not sync.
+  static GURL GetServerURL(const PrefService& prefs);
+
+  // Reads the chain's secret: from --arcomium-sync-secret (64 hex digits),
+  // which is then stored encrypted, or from prefs. Returns nullopt when there
+  // is none or it cannot be decrypted.
+  static std::optional<ArcomiumSyncAccount> Load(
+      PrefService* prefs,
+      const os_crypt_async::Encryptor& encryptor);
+
+  explicit ArcomiumSyncAccount(
+      const std::array<uint8_t, kSecretSize>& secret);
+  ArcomiumSyncAccount(const ArcomiumSyncAccount&);
+  ArcomiumSyncAccount& operator=(const ArcomiumSyncAccount&);
+  ~ArcomiumSyncAccount();
+
+  // A token for the server, valid from `now` for a day:
+  // base64url(0x01 | public key | issued at (ms, big-endian) | signature),
+  // signed over "arcomium-sync-token-v1" | public key | issued at.
+  std::string MakeToken(base::Time now) const;
+
+  // The custom passphrase of the chain's data.
+  const std::string& passphrase() const { return passphrase_; }
+
+ private:
+  std::array<uint8_t, 32> public_key_;
+  std::array<uint8_t, 64> private_key_;
+  std::string passphrase_;
+};
+
+}  // namespace syncer
+
+#endif  // COMPONENTS_SYNC_SERVICE_ARCOMIUM_SYNC_ACCOUNT_H_
diff --git a/components/sync/service/arcomium_sync_events.cc b/components/sync/service/arcomium_sync_events.cc
new file mode 100644
index 0000000000..4b1c15d4de
--- /dev/null
+++ b/components/sync/service/arcomium_sync_events.cc
@@ -0,0 +1,181 @@
+// Copyright 2026 The Arcomium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/sync/service/arcomium_sync_events.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/strings/escape.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "net/base/load_flags.h"
+#include "net/http/http_request_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+
+namespace syncer {
+
+namespace {
+
+constexpr base::TimeDelta kFirstReconnectDelay = base::Seconds(5);
+constexpr base::TimeDelta kMaxReconnectDelay = base::Minutes(5);
+// A line longer than this is not an event of the server's.
+constexpr size_t kMaxLineLength = 64 * 1024;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("arcomium_sync_events", R"(
+      semantics {
+        sender: "Arcomium Sync"
+        description:
+          "Keeps a stream open to the Arcomium sync server the user chose, "
+          "which says when another device of the user's sync chain changed "
+          "data, so this device fetches the change right away."
+        trigger: "Sync with an Arcomium server is set up and running."
+        data:
+          "A token signed with the sync chain's key and this device's sync "
+          "cache ID. No browsing data is sent."
+        destination: OTHER
+        destination_other: "The Arcomium sync server the user set up."
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Turn off Arcomium sync in settings."
+        policy_exception_justification: "Not implemented."
+      })");
+
+GURL MakeEventsURL(const GURL& server_url, const std::string& cache_guid) {
+  std::string spec = server_url.spec();
+  if (!spec.ends_with('/')) {
+    spec += '/';
+  }
+  return GURL(spec + "events?cache_guid=" +
+              base::EscapeQueryParamValue(cache_guid, /*use_plus=*/true));
+}
+
+}  // namespace
+
+ArcomiumSyncEvents::ArcomiumSyncEvents(
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory,
+    const GURL& server_url,
+    const std::string& cache_guid,
+    TokenGetter token_getter,
+    Refresh refresh)
+    : url_loader_factory_(std::move(url_loader_factory)),
+      events_url_(MakeEventsURL(server_url, cache_guid)),
+      token_getter_(std::move(token_getter)),
+      refresh_(std::move(refresh)),
+      reconnect_delay_(kFirstReconnectDelay) {
+  Connect();
+}
+
+ArcomiumSyncEvents::~ArcomiumSyncEvents() = default;
+
+void ArcomiumSyncEvents::Connect() {
+  pending_.clear();
+  event_name_.clear();
+  event_data_.clear();
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = events_url_;
+  request->method = net::HttpRequestHeaders::kGetMethod;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                             "Bearer " + token_getter_.Run());
+  request->headers.SetHeader(net::HttpRequestHeaders::kAccept,
+                             "text/event-stream");
+
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kTrafficAnnotation);
+  loader_->DownloadAsStream(url_loader_factory_.get(), this);
+}
+
+void ArcomiumSyncEvents::OnDataReceived(std::string_view data,
+                                        base::OnceClosure resume) {
+  // Data means the server accepted the stream.
+  reconnect_delay_ = kFirstReconnectDelay;
+  pending_.append(data);
+  size_t start = 0;
+  for (size_t end; (end = pending_.find('\n', start)) != std::string::npos;
+       start = end + 1) {
+    std::string_view line(pending_.data() + start, end - start);
+    if (line.ends_with('\r')) {
+      line.remove_suffix(1);
+    }
+    HandleLine(line);
+  }
+  pending_.erase(0, start);
+  if (pending_.size() > kMaxLineLength) {
+    pending_.clear();
+  }
+  std::move(resume).Run();
+}
+
+void ArcomiumSyncEvents::OnComplete(bool success) {
+  // The stream should not end; when it does, connect again, waiting longer
+  // each time it fails before any data.
+  loader_.reset();
+  reconnect_timer_.Start(FROM_HERE, reconnect_delay_,
+                         base::BindOnce(&ArcomiumSyncEvents::Connect,
+                                        base::Unretained(this)));
+  reconnect_delay_ = std::min(reconnect_delay_ * 2, kMaxReconnectDelay);
+}
+
+void ArcomiumSyncEvents::OnRetry(base::OnceClosure start_retry) {
+  // Retries are not enabled.
+  NOTREACHED();
+}
+
+void ArcomiumSyncEvents::HandleLine(std::string_view line) {
+  if (line.empty()) {
+    DispatchEvent();
+    return;
+  }
+  if (line.starts_with(':')) {
+    return;  // A comment, such as the server's keep-alive ping.
+  }
+  if (line.starts_with("event:")) {
+    event_name_ = std::string(
+        base::TrimWhitespaceASCII(line.substr(6), base::TRIM_LEADING));
+  } else if (line.starts_with("data:")) {
+    event_data_ = std::string(
+        base::TrimWhitespaceASCII(line.substr(5), base::TRIM_LEADING));
+  }
+}
+
+void ArcomiumSyncEvents::DispatchEvent() {
+  const std::string name = std::exchange(event_name_, std::string());
+  const std::string data = std::exchange(event_data_, std::string());
+
+  if (name == "ready" || name == "resync") {
+    refresh_.Run(ProtocolTypes());
+    return;
+  }
+  if (name != "changed") {
+    return;
+  }
+  std::optional<base::DictValue> event = base::JSONReader::ReadDict(data, base::JSON_PARSE_RFC);
+  const base::ListValue* numbers = event ? event->FindList("types") : nullptr;
+  if (!numbers) {
+    return;
+  }
+  DataTypeSet types;
+  for (const base::Value& number : *numbers) {
+    if (number.is_int()) {
+      const DataType type = GetDataTypeFromSpecificsFieldNumber(number.GetInt());
+      if (type != UNSPECIFIED) {
+        types.Put(type);
+      }
+    }
+  }
+  if (!types.empty()) {
+    refresh_.Run(types);
+  }
+}
+
+}  // namespace syncer
