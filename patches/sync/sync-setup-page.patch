+</main>
+</body>
+</html>
+)HTML";
+
+inline constexpr char kArcomiumSyncCss[] = R"CSS(
+:root {
+  --bg: #f6f5f8;
+  --panel: #ffffff;
+  --fg: #1d1b22;
+  --muted: #5f5b69;
+  --line: #e2dfe8;
+  --accent: #5b4bdb;
+  --accent-fg: #ffffff;
+  --ok: #1f8a4c;
+  --warn: #b26a00;
+  --bad: #c62f3a;
+  color-scheme: light dark;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #17161b;
+    --panel: #211f27;
+    --fg: #ecebf0;
+    --muted: #a7a3b2;
+    --line: #34313d;
+    --accent: #8d80f2;
+    --accent-fg: #17161b;
+    --ok: #4cc27f;
+    --warn: #e2a443;
+    --bad: #f0707a;
+  }
+}
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--fg);
+  font: 14px/1.5 system-ui, "Segoe UI", sans-serif;
+}
+main {
+  max-width: 36rem;
+  margin: 0 auto;
+  padding: 48px 20px;
+  display: grid;
+  gap: 24px;
+}
+h1 { margin: 0 0 8px; font-size: 28px; font-weight: 600; }
+h2 { margin: 0 0 4px; font-size: 16px; font-weight: 600; }
+p { margin: 0; }
+.lede, .card > p, #code > p { color: var(--muted); }
+section, .card { display: grid; gap: 12px; }
+.card, #status, #code, .banner {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  padding: 20px;
+}
+#setup { gap: 16px; }
+label { font-weight: 500; margin-bottom: -6px; }
+input, textarea {
+  font: inherit;
+  color: inherit;
+  background: var(--bg);
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  padding: 8px 10px;
+}
+textarea { resize: vertical; }
+input:focus-visible, textarea:focus-visible, button:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+button {
+  font: inherit;
+  font-weight: 500;
+  color: var(--fg);
+  background: transparent;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  padding: 7px 14px;
+  cursor: pointer;
+  justify-self: start;
+}
+button.primary {
+  background: var(--accent);
+  border-color: var(--accent);
+  color: var(--accent-fg);
+}
+button.danger { color: var(--bad); border-color: var(--bad); }
+button.quiet { color: var(--muted); }
+button:disabled { opacity: .6; cursor: default; }
+.actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.error { color: var(--bad); }
+.note { color: var(--muted); }
+.banner { border-color: var(--accent); }
+.status-line { display: flex; align-items: center; gap: 8px; font-weight: 500; }
+.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); flex: none; }
+.dot.ok { background: var(--ok); }
+.dot.warn { background: var(--warn); }
+.dot.bad { background: var(--bad); }
+dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0; }
+dt { color: var(--muted); }
