diff --git a/chrome/browser/ui/chrome_pages.cc b/chrome/browser/ui/chrome_pages.cc
index 9f616639b50..5b6a5ad42ae 100644
--- a/chrome/browser/ui/chrome_pages.cc
+++ b/chrome/browser/ui/chrome_pages.cc
@@ -487,6 +487,14 @@ void ShowSettingsSubPageInTabbedBrowser(BrowserWindowInterface* browser,
                                         std::string_view sub_page) {
   base::RecordAction(UserMetricsAction("ShowOptions"));
 
+  // Arcomium sets up sync on its own page; Chromium's sync settings are for
+  // Google accounts.
+  if (sub_page == kSyncSetupSubPage) {
+    FocusWebContents(browser);
+    ShowSingletonTab(browser, GURL("chrome://arcomium-sync/"));
+    return;
+  }
+
   // Since the user may be triggering navigation from another UI element such as
   // a menu, ensure the web contents (and therefore the settings page that is
   // about to be shown) is focused. (See crbug.com/41438063 for motivation.)
diff --git a/chrome/browser/ui/toolbar/app_menu_model.cc b/chrome/browser/ui/toolbar/app_menu_model.cc
index 4d155299d24..0e71d492421 100644
--- a/chrome/browser/ui/toolbar/app_menu_model.cc
+++ b/chrome/browser/ui/toolbar/app_menu_model.cc
@@ -2322,6 +2322,13 @@ void AppMenuModel::Build() {
 #endif
 #endif
 
+  // Arcomium: sync has no Google account to show it, so it gets its own
+  // item, opening chrome://arcomium-sync.
+  AddItemWithStringIdAndVectorIcon(
+      this, IDC_SHOW_SYNC_SETTINGS, IDS_SETTINGS_SYNC,
+      features::IsRoundedIconsEnabled() ? vector_icons::kSyncIcon
+                                        : kSyncRefreshOldIcon);
+
   AddItemWithStringIdAndVectorIcon(
       this, IDC_OPTIONS, IDS_SETTINGS,
       features::IsRoundedIconsEnabled() ? kSettingsIcon : kSettingsMenuOldIcon);
