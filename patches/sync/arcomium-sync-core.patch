+void SyncServiceImpl::LeaveArcomiumSyncChain() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ArcomiumSyncAccount::Clear(sync_client_->GetPrefService());
+  arcomium_account_.reset();
+  StopAndClear(ResetEngineReason::kResetLocalData);
+}
+
+void SyncServiceImpl::UpdateArcomiumCredentials() {
+  if (!engine_ || !arcomium_account_) {
+    return;
+  }
+  const base::Time now = base::Time::Now();
+  SyncCredentials credentials;
+  credentials.access_token_info = signin::AccessTokenInfo(
+      arcomium_account_->MakeToken(now), now + base::Hours(23),
+      /*id_token=*/std::string());
+  engine_->UpdateCredentials(credentials);
+}
+
+// Encrypts the chain's data with its passphrase: the first device sets it,
+// the others decrypt with it.
+void SyncServiceImpl::MaybeApplyArcomiumPassphrase() {
+  if (!arcomium_account_ || !engine_ || !engine_->IsInitialized() ||
+      applying_arcomium_passphrase_) {
+    return;
+  }
+  base::AutoReset<bool> applying(&applying_arcomium_passphrase_, true);
+
+  if (user_settings_->IsPassphraseRequired()) {
+    if (!user_settings_->SetDecryptionPassphrase(
+            arcomium_account_->passphrase())) {
+      LOG(ERROR) << "The sync chain's data is encrypted with another "
+                    "passphrase";
+    }
+    return;
+  }
+  if (arcomium_passphrase_set_) {
+    return;
+  }
+  const std::optional<PassphraseType> type =
+      user_settings_->GetPassphraseType();
+  if (!type || user_settings_->IsTrustedVaultKeyRequired()) {
+    return;  // Encryption state not known yet.
+  }
+  arcomium_passphrase_set_ = true;
+  if (!IsExplicitPassphrase(*type)) {
+    user_settings_->SetEncryptionPassphrase(arcomium_account_->passphrase());
+  }
 }
 
