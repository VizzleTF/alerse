diff --git a/components/sync/service/arcomium_sync_account.cc b/components/sync/service/arcomium_sync_account.cc
new file mode 100644
index 0000000000..6464a216d3
--- /dev/null
+++ b/components/sync/service/arcomium_sync_account.cc
@@ -0,0 +1,175 @@
+// Copyright 2026 The Arcomium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/sync/service/arcomium_sync_account.h"
+
+#include <string_view>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/base64url.h"
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/logging.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/strings/string_number_conversions.h"
+#include "components/os_crypt/async/common/encryptor.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "third_party/boringssl/src/include/openssl/curve25519.h"
+#include "third_party/boringssl/src/include/openssl/digest.h"
+#include "third_party/boringssl/src/include/openssl/hkdf.h"
+
+namespace syncer {
+
+namespace {
+
+constexpr char kServerURLPref[] = "arcomium.sync.server_url";
+constexpr char kSecretPref[] = "arcomium.sync.secret";
+
+// For setting up a device by hand until the settings page exists. The secret
+// on a command line is visible to other programs of the user, so the switch
+// is for testing only.
+constexpr char kServerURLSwitch[] = "arcomium-sync-url";
+constexpr char kSecretSwitch[] = "arcomium-sync-secret";
+
+constexpr uint8_t kTokenVersion = 0x01;
+constexpr std::string_view kTokenContext = "arcomium-sync-token-v1";
+constexpr std::string_view kKdfSalt = "arcomium-sync";
+constexpr std::string_view kKeyInfo = "ed25519-key";
+constexpr std::string_view kPassphraseInfo = "nigori-passphrase";
+
+std::array<uint8_t, 32> Derive(base::span<const uint8_t> secret,
+                               std::string_view info) {
+  std::array<uint8_t, 32> out;
+  CHECK(HKDF(out.data(), out.size(), EVP_sha256(), secret.data(),
+             secret.size(), reinterpret_cast<const uint8_t*>(kKdfSalt.data()),
+             kKdfSalt.size(), reinterpret_cast<const uint8_t*>(info.data()),
+             info.size()));
+  return out;
+}
+
+}  // namespace
+
+// static
+void ArcomiumSyncAccount::RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterStringPref(kServerURLPref, std::string());
+  registry->RegisterStringPref(kSecretPref, std::string());
+}
+
+// static
+void ArcomiumSyncAccount::ApplyCommandLine(PrefService* prefs) {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch(kServerURLSwitch)) {
+    prefs->SetString(kServerURLPref,
+                     command_line.GetSwitchValueASCII(kServerURLSwitch));
+  }
+}
+
+// static
+GURL ArcomiumSyncAccount::GetServerURL(const PrefService& prefs) {
+  GURL url(prefs.GetString(kServerURLPref));
+  return url.is_valid() ? url : GURL();
+}
+
+// static
+void ArcomiumSyncAccount::Save(PrefService* prefs,
+                               const os_crypt_async::Encryptor& encryptor,
+                               const GURL& server_url,
+                               const SyncChainSecret& secret) {
+  std::string ciphertext;
+  // Encryption fails only when the OS keystore is unavailable; then the
+  // secret is not kept and sync does not start.
+  if (!encryptor.EncryptString(std::string(secret.begin(), secret.end()),
+                               &ciphertext)) {
+    LOG(ERROR) << "Cannot encrypt the Arcomium sync secret";
+    ciphertext.clear();
+  }
+  prefs->SetString(kSecretPref, base::Base64Encode(ciphertext));
+  prefs->SetString(kServerURLPref, server_url.spec());
+}
+
+// static
+void ArcomiumSyncAccount::Clear(PrefService* prefs) {
+  prefs->ClearPref(kServerURLPref);
+  prefs->ClearPref(kSecretPref);
+}
+
+// static
+std::optional<SyncChainSecret> ArcomiumSyncAccount::LoadSecret(
+    const PrefService& prefs,
+    const os_crypt_async::Encryptor& encryptor) {
+  std::string ciphertext;
+  std::string plaintext;
+  if (!base::Base64Decode(prefs.GetString(kSecretPref), &ciphertext) ||
+      ciphertext.empty() || !encryptor.DecryptString(ciphertext, &plaintext) ||
+      plaintext.size() != kSecretSize) {
+    return std::nullopt;
+  }
+  SyncChainSecret secret;
+  base::span(secret).copy_from(base::as_byte_span(plaintext));
+  return secret;
+}
+
+// static
+std::optional<ArcomiumSyncAccount> ArcomiumSyncAccount::Load(
+    PrefService* prefs,
+    const os_crypt_async::Encryptor& encryptor) {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch(kSecretSwitch)) {
+    SyncChainSecret secret;
+    if (!base::HexStringToSpan(command_line.GetSwitchValueASCII(kSecretSwitch),
+                               secret)) {
+      LOG(ERROR) << "--" << kSecretSwitch << " needs 64 hex digits";
+      return std::nullopt;
+    }
+    Save(prefs, encryptor, GetServerURL(*prefs), secret);
+    return ArcomiumSyncAccount(secret);
+  }
+
+  std::optional<SyncChainSecret> secret = LoadSecret(*prefs, encryptor);
+  if (!secret) {
+    return std::nullopt;
+  }
+  return ArcomiumSyncAccount(*secret);
+}
+
+ArcomiumSyncAccount::ArcomiumSyncAccount(const SyncChainSecret& secret) {
+  const std::array<uint8_t, 32> seed = Derive(secret, kKeyInfo);
+  ED25519_keypair_from_seed(public_key_.data(), private_key_.data(),
+                            seed.data());
+  passphrase_ = base::Base64Encode(Derive(secret, kPassphraseInfo));
+}
+
+ArcomiumSyncAccount::ArcomiumSyncAccount(const ArcomiumSyncAccount&) = default;
+ArcomiumSyncAccount& ArcomiumSyncAccount::operator=(
+    const ArcomiumSyncAccount&) = default;
+ArcomiumSyncAccount::~ArcomiumSyncAccount() = default;
+
+std::string ArcomiumSyncAccount::MakeToken(base::Time now) const {
+  std::vector<uint8_t> token;
+  token.push_back(kTokenVersion);
+  token.insert(token.end(), public_key_.begin(), public_key_.end());
+  const auto issued_at = base::U64ToBigEndian(
+      static_cast<uint64_t>(now.InMillisecondsSinceUnixEpoch()));
+  token.insert(token.end(), issued_at.begin(), issued_at.end());
+
+  // Signed: the context, then the key and time (the token without its
+  // version byte).
+  std::vector<uint8_t> message(kTokenContext.begin(), kTokenContext.end());
+  message.insert(message.end(), token.begin() + 1, token.end());
+  std::array<uint8_t, 64> signature;
+  CHECK(ED25519_sign(signature.data(), message.data(), message.size(),
+                     private_key_.data()));
+  token.insert(token.end(), signature.begin(), signature.end());
+
+  std::string encoded;
+  base::Base64UrlEncode(token, base::Base64UrlEncodePolicy::OMIT_PADDING,
+                        &encoded);
+  return encoded;
+}
+
+}  // namespace syncer
diff --git a/components/sync/service/arcomium_sync_account.h b/components/sync/service/arcomium_sync_account.h
new file mode 100644
index 0000000000..7576af25ab
--- /dev/null
+++ b/components/sync/service/arcomium_sync_account.h
@@ -0,0 +1,90 @@
+// Copyright 2026 The Arcomium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_SYNC_SERVICE_ARCOMIUM_SYNC_ACCOUNT_H_
+#define COMPONENTS_SYNC_SERVICE_ARCOMIUM_SYNC_ACCOUNT_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "base/time/time.h"
+#include "components/sync/service/arcomium_sync_code.h"
+#include "url/gurl.h"
+
+class PrefRegistrySimple;
+class PrefService;
+
+namespace os_crypt_async {
+class Encryptor;
+}  // namespace os_crypt_async
+
+namespace syncer {
+
+// Arcomium syncs without a Google account. The devices of a sync chain share
+// a 32-byte secret, from which each derives the same Ed25519 key pair, which
+// is the chain's identity on the server, and the same custom passphrase,
+// which encrypts all data before it leaves the device.
+//
+// The server URL lives in prefs; the secret is kept encrypted with OSCrypt.
+// Sync runs in Chromium's local sync mode (no account, full sync) against the
+// server, with tokens signed by the chain's key as access tokens.
+class ArcomiumSyncAccount {
+ public:
+  static constexpr size_t kSecretSize = 32;
+
+  static void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+  // Copies --arcomium-sync-url into prefs. Call before SyncPrefs reads
+  // whether sync is enabled.
+  static void ApplyCommandLine(PrefService* prefs);
+
+  // The server's URL, or an empty one when the profile does not sync.
+  static GURL GetServerURL(const PrefService& prefs);
+
+  // Saves a profile's setup: the server and the chain's secret, encrypted.
+  // Sync starts with it at the next browser start.
+  static void Save(PrefService* prefs,
+                   const os_crypt_async::Encryptor& encryptor,
+                   const GURL& server_url,
+                   const SyncChainSecret& secret);
+
+  // Forgets the setup. Sync stops at the next browser start.
+  static void Clear(PrefService* prefs);
+
+  // Reads the saved secret, or nullopt.
+  static std::optional<SyncChainSecret> LoadSecret(
+      const PrefService& prefs,
+      const os_crypt_async::Encryptor& encryptor);
+
+  // Reads the chain's secret: from --arcomium-sync-secret (64 hex digits),
+  // which is then saved, or from prefs. Returns nullopt when there is none or
+  // it cannot be decrypted.
+  static std::optional<ArcomiumSyncAccount> Load(
+      PrefService* prefs,
+      const os_crypt_async::Encryptor& encryptor);
+
+  explicit ArcomiumSyncAccount(const SyncChainSecret& secret);
+  ArcomiumSyncAccount(const ArcomiumSyncAccount&);
+  ArcomiumSyncAccount& operator=(const ArcomiumSyncAccount&);
+  ~ArcomiumSyncAccount();
+
+  // A token for the server, valid from `now` for a day:
+  // base64url(0x01 | public key | issued at (ms, big-endian) | signature),
+  // signed over "arcomium-sync-token-v1" | public key | issued at.
+  std::string MakeToken(base::Time now) const;
+
+  // The custom passphrase of the chain's data.
+  const std::string& passphrase() const { return passphrase_; }
+
+ private:
+  std::array<uint8_t, 32> public_key_;
+  std::array<uint8_t, 64> private_key_;
+  std::string passphrase_;
+};
+
+}  // namespace syncer
+
+#endif  // COMPONENTS_SYNC_SERVICE_ARCOMIUM_SYNC_ACCOUNT_H_
diff --git a/components/sync/service/arcomium_sync_code.cc b/components/sync/service/arcomium_sync_code.cc
new file mode 100644
index 0000000000..5d7e03f4a1
--- /dev/null
+++ b/components/sync/service/arcomium_sync_code.cc
@@ -0,0 +1,110 @@
+// Copyright 2026 The Arcomium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/sync/service/arcomium_sync_code.h"
+
+#include <algorithm>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/rand_util.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "third_party/boringssl/src/include/openssl/sha.h"
+
+namespace syncer {
+
+namespace {
+
+#include "components/sync/service/arcomium_sync_words.inc"
+
+constexpr size_t kWordCount = 24;
+constexpr size_t kBitsPerWord = 11;
+constexpr size_t kPrefixLength = 4;
+
+uint8_t Checksum(const SyncChainSecret& secret) {
+  uint8_t digest[SHA256_DIGEST_LENGTH];
+  SHA256(secret.data(), secret.size(), digest);
+  return digest[0];
+}
+
+// Returns the index of the word that `typed` names, or nullopt.
+std::optional<size_t> FindWord(std::string_view typed) {
+  const std::string_view prefix = typed.substr(0, kPrefixLength);
+  const auto it = std::lower_bound(kSyncCodeWords.begin(),
+                                   kSyncCodeWords.end(), prefix);
+  if (it == kSyncCodeWords.end() || !it->starts_with(prefix)) {
+    return std::nullopt;
+  }
+  // Four letters or more name one word, and the rest has to match it. Fewer
+  // letters have to be a whole word, such as "add".
+  const bool matches = typed.size() < kPrefixLength ? *it == typed
+                                                    : it->starts_with(typed);
+  if (!matches) {
+    return std::nullopt;
+  }
+  return static_cast<size_t>(it - kSyncCodeWords.begin());
+}
+
+}  // namespace
+
+SyncChainSecret GenerateSyncChainSecret() {
+  SyncChainSecret secret;
+  base::RandBytes(secret);
+  return secret;
+}
+
+std::string EncodeSyncCode(const SyncChainSecret& secret) {
+  // 264 bits: the secret, then the checksum byte.
+  std::array<uint8_t, 33> bits;
+  base::span(bits).first<32>().copy_from(secret);
+  bits[32] = Checksum(secret);
+
+  std::string code;
+  for (size_t word = 0; word < kWordCount; ++word) {
+    size_t index = 0;
+    for (size_t bit = word * kBitsPerWord; bit < (word + 1) * kBitsPerWord;
+         ++bit) {
+      index = (index << 1) | ((bits[bit / 8] >> (7 - bit % 8)) & 1);
+    }
+    if (!code.empty()) {
+      code += ' ';
+    }
+    code += kSyncCodeWords[index];
+  }
+  return code;
+}
+
+std::optional<SyncChainSecret> DecodeSyncCode(std::string_view code) {
+  const std::string lower = base::ToLowerASCII(code);
+  const std::vector<std::string_view> words = base::SplitStringPiece(
+      lower, base::kWhitespaceASCII, base::TRIM_WHITESPACE,
+      base::SPLIT_WANT_NONEMPTY);
+  if (words.size() != kWordCount) {
+    return std::nullopt;
+  }
+
+  std::array<uint8_t, 33> bits = {};
+  size_t bit = 0;
+  for (std::string_view typed : words) {
+    const std::optional<size_t> index = FindWord(typed);
+    if (!index) {
+      return std::nullopt;
+    }
+    for (size_t i = kBitsPerWord; i-- > 0; ++bit) {
+      if ((*index >> i) & 1) {
+        bits[bit / 8] |= 1 << (7 - bit % 8);
+      }
+    }
+  }
+
+  SyncChainSecret secret;
+  base::span(secret).copy_from(base::span(bits).first<32>());
+  if (Checksum(secret) != bits[32]) {
+    return std::nullopt;
+  }
+  return secret;
+}
+
+}  // namespace syncer
diff --git a/components/sync/service/arcomium_sync_code.h b/components/sync/service/arcomium_sync_code.h
new file mode 100644
index 0000000000..cbbdf81250
--- /dev/null
+++ b/components/sync/service/arcomium_sync_code.h
@@ -0,0 +1,35 @@
+// Copyright 2026 The Arcomium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_SYNC_SERVICE_ARCOMIUM_SYNC_CODE_H_
+#define COMPONENTS_SYNC_SERVICE_ARCOMIUM_SYNC_CODE_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace syncer {
+
+// A sync chain's secret written as a sync code: 24 words of the BIP39 English
+// list, the 256 bits of the secret followed by the first 8 bits of its
+// SHA-256 as a checksum, 11 bits a word. The same encoding as a BIP39
+// mnemonic, so the words are ones people know from wallets.
+using SyncChainSecret = std::array<uint8_t, 32>;
+
+// Returns a new random secret.
+SyncChainSecret GenerateSyncChainSecret();
+
+// Returns the 24 words of `secret`, separated by spaces.
+std::string EncodeSyncCode(const SyncChainSecret& secret);
+
+// Reads a sync code as people type it: any case, any whitespace between
+// words, and each word may be cut to its first four letters, which tell
+// every word apart. Returns nullopt for a wrong word, count or checksum.
+std::optional<SyncChainSecret> DecodeSyncCode(std::string_view code);
+
+}  // namespace syncer
+
+#endif  // COMPONENTS_SYNC_SERVICE_ARCOMIUM_SYNC_CODE_H_
diff --git a/components/sync/service/arcomium_sync_code_unittest.cc b/components/sync/service/arcomium_sync_code_unittest.cc
new file mode 100644
index 0000000000..4d9736f861
--- /dev/null
+++ b/components/sync/service/arcomium_sync_code_unittest.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 The Arcomium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/sync/service/arcomium_sync_code.h"
+
+#include "base/strings/string_number_conversions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace syncer {
+namespace {
+
+SyncChainSecret FromHex(std::string_view hex) {
+  SyncChainSecret secret;
+  CHECK(base::HexStringToSpan(hex, secret));
+  return secret;
+}
+
+// Test vectors of BIP39 (256-bit entropy).
+TEST(ArcomiumSyncCodeTest, MatchesBip39Vectors) {
+  EXPECT_EQ(EncodeSyncCode(FromHex(std::string(64, '0'))),
+            "abandon abandon abandon abandon abandon abandon abandon abandon "
+            "abandon abandon abandon abandon abandon abandon abandon abandon "
+            "abandon abandon abandon abandon abandon abandon abandon art");
+  EXPECT_EQ(EncodeSyncCode(FromHex(std::string(64, 'f'))),
+            "zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo "
+            "zoo zoo zoo zoo zoo zoo zoo vote");
+}
+
+TEST(ArcomiumSyncCodeTest, RoundTrips) {
+  for (int i = 0; i < 100; ++i) {
+    const SyncChainSecret secret = GenerateSyncChainSecret();
+    EXPECT_EQ(DecodeSyncCode(EncodeSyncCode(secret)), secret);
+  }
+}
+
+TEST(ArcomiumSyncCodeTest, ReadsCodesAsTyped) {
+  const SyncChainSecret secret = FromHex(std::string(64, 'f'));
+  EXPECT_EQ(DecodeSyncCode("  ZOO zoo\tzoo zoo zoo zoo zoo zoo zoo zoo zoo zoo\n"
+                           "zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo vote "),
+            secret);
+  // Four letters name a word.
+  EXPECT_EQ(DecodeSyncCode("abandon abandon abandon abandon abandon abandon "
+                           "aban aban aban aban aban aban aban aban aban aban "
+                           "aban aban aban aban aban aban aban art"),
+            FromHex(std::string(64, '0')));
+}
+
+TEST(ArcomiumSyncCodeTest, RejectsWrongCodes) {
+  const std::string code = EncodeSyncCode(GenerateSyncChainSecret());
+  // Too few words, an unknown word, a word cut too short, a bad checksum.
+  EXPECT_FALSE(DecodeSyncCode(code.substr(0, code.rfind(' '))));
+  EXPECT_FALSE(DecodeSyncCode("notaword " + code.substr(code.find(' ') + 1)));
+  EXPECT_FALSE(DecodeSyncCode(
+      "aba abandon abandon abandon abandon abandon abandon abandon abandon "
+      "abandon abandon abandon abandon abandon abandon abandon abandon abandon "
+      "abandon abandon abandon abandon abandon art"));
+  EXPECT_FALSE(DecodeSyncCode(
+      "abandon abandon abandon abandon abandon abandon abandon abandon abandon "
+      "abandon abandon abandon abandon abandon abandon abandon abandon abandon "
+      "abandon abandon abandon abandon abandon zoo"));
+}
+
+}  // namespace
+}  // namespace syncer
