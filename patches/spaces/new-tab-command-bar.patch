@@ -765,6 +766,11 @@ void BrowserCommandController::HandleCommandWithDisposition(
       CloseWindow(browser_);
       break;
     case IDC_NEW_TAB: {
+      // Arcomium: as in Arc, New Tab opens the command bar; a tab opens only
