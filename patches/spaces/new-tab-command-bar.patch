       NewTab(browser_, NewTabTypes::kNewTabCommand);
       break;
     }
diff --git a/chrome/browser/ui/browser_commands.cc b/chrome/browser/ui/browser_commands.cc
index ac2ba9e..9bdd9f2 100644
--- a/chrome/browser/ui/browser_commands.cc
+++ b/chrome/browser/ui/browser_commands.cc
@@ -110,6 +110,7 @@
 #include "chrome/browser/ui/status_bubble.h"
 #include "chrome/browser/ui/tab_contents/core_tab_helper.h"
 #include "chrome/browser/ui/tab_dialogs.h"
+#include "chrome/browser/ui/tabs/arcomium_command_bar_hook.h"
 #include "chrome/browser/ui/tabs/back_to_opener/back_to_opener_controller.h"
 #include "chrome/browser/ui/tabs/features.h"
 #include "chrome/browser/ui/tabs/new_tab_grouping_user_data.h"
@@ -996,6 +997,19 @@ BrowserWindowInterface* OpenEmptyWindow(Profile* profile,
 
   // Startup tabs could be created during browser creation. Add an empty tab
   // only if no tabs are created.
+  // Arcomium: as in Arc, a new window is an empty Space with the command bar
+  // open, where the sidebar shows; otherwise it gets a new tab after all.
+  if (browser->GetTabStripModel()->empty() && arcomium::NewTabCommandBarHook()) {
+    AddTabAt(browser, GURL("about:blank#arcomium-space"), -1, true);
+    browser->GetWindow()->Show();
+    if (!arcomium::OpenNewTabCommandBar(browser)) {
+      // The new tab replaces the blank one, which would show as a tab there.
+      AddTabAt(browser, GURL(), -1, true);
+      browser->GetTabStripModel()->CloseWebContentsAt(
+          0, TabCloseTypes::CLOSE_NONE);
+    }
+    return browser;
+  }
   if (browser->GetTabStripModel()->empty()) {
     AddTabAt(browser, GURL(), -1, true);
   }
