+namespace {
+
+// Arcomium: Arc's header row, measured on Arc for Windows at 100% scale.
+constexpr int kArcHeaderHeight = 32;
+constexpr int kArcHeaderButtonSize = 28;
+constexpr int kArcHeaderIconSize = 16;
+constexpr SkColor kArcHeaderIconColor = SkColorSetRGB(0xD7, 0xD7, 0xD7);
+
+// Arc's logo, an arch crossed by a swoosh; opens the app menu.
+class ArcLogoButton : public views::Button {
+  METADATA_HEADER(ArcLogoButton, views::Button)
+
+ public:
+  explicit ArcLogoButton(PressedCallback callback)
+      : views::Button(std::move(callback)) {
+    SetTooltipText(u"Arcomium menu");
+    GetViewAccessibility().SetName(u"Arcomium menu");
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::ON);
+    views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(), 6);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const gfx::PointF origin((width() - kArcHeaderIconSize) / 2.0f,
+                             (height() - kArcHeaderIconSize) / 2.0f);
+    SkPathBuilder arch;
+    arch.moveTo(origin.x() + 2.5f, origin.y() + 14);
+    arch.cubicTo(origin.x() + 3.5f, origin.y() + 4, origin.x() + 6,
+                 origin.y() + 1.5f, origin.x() + 8, origin.y() + 1.5f);
+    arch.cubicTo(origin.x() + 10, origin.y() + 1.5f, origin.x() + 12.5f,
+                 origin.y() + 4, origin.x() + 13.5f, origin.y() + 14);
+    SkPathBuilder swoosh;
+    swoosh.moveTo(origin.x() + 1, origin.y() + 10.5f);
+    swoosh.cubicTo(origin.x() + 5, origin.y() + 6.5f, origin.x() + 10,
+                   origin.y() + 6.5f, origin.x() + 15, origin.y() + 9.5f);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1.4f);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    flags.setColor(kArcHeaderIconColor);
+    canvas->DrawPath(arch.detach(), flags);
+    canvas->DrawPath(swoosh.detach(), flags);
+  }
+};
+
+BEGIN_METADATA(ArcLogoButton)
+END_METADATA
