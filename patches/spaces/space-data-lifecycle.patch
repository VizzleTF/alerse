+  //////////////////////////////////////////////////////////////////////////////
+  // Alerse: Spaces.
+  // Each Space keeps its sites' data in its own storage partition
+  // (chrome/browser/ui/tabs/alerse_spaces.h). Without a partition named in
+  // the filter, the same removal runs on every Space's, open or not: the
+  // loaded ones and those the Spaces' bookmark folders name.
+  if (!filter_builder->GetStoragePartitionConfig().has_value() &&
+      !profile_->IsOffTheRecord()) {
+    std::set<std::string> spaces;
+    profile_->ForEachLoadedStoragePartition(
+        [&spaces](content::StoragePartition* partition) {
+          const content::StoragePartitionConfig& config =
+              partition->GetConfig();
+          if (config.partition_domain() == "arcomium" && !config.in_memory() &&
+              !config.partition_name().empty()) {
+            spaces.insert(config.partition_name());
+          }
+        });
+    if (bookmarks::BookmarkModel* bookmarks =
+            BookmarkModelFactory::GetForBrowserContext(profile_);
+        bookmarks && bookmarks->loaded()) {
+      for (const auto& folder : bookmarks->other_node()->children()) {
+        std::string space;
+        if (folder->is_folder() &&
+            folder->GetMetaInfo("arcomium.space", &space) && !space.empty() &&
+            space != "default" && !space.starts_with("arc:")) {
+          spaces.insert(space);
+        }
+      }
+    }
+    const uint64_t space_remove_mask =
+        content::BrowsingDataRemover::DATA_TYPE_ON_STORAGE_PARTITION &
+        remove_mask;
+    if (space_remove_mask) {
+      for (const std::string& space : spaces) {
+        // Not waited for: BrowsingDataRemover takes no nested Remove calls.
+        std::unique_ptr<content::BrowsingDataFilterBuilder> space_filter =
+            filter_builder->Copy();
+        space_filter->SetStoragePartitionConfig(
+            content::StoragePartitionConfig::Create(profile_, "arcomium", space,
+                                                    /*in_memory=*/false));
+        profile_->GetBrowsingDataRemover()->RemoveWithFilter(
+            delete_begin, delete_end, space_remove_mask, origin_type_mask,
+            std::move(space_filter));
+      }
+    }
+  }
+
