   if (ArcomiumEmptySpaceMarker::FromWebContents(contents)) {
     return true;
   }
+  // In a Space, a blank page or the New Tab page, which cannot load in the
+  // Space's storage partition, is its empty page: another device's empty Space
+  // syncs as the New Tab page, and sync navigates the tab there.
