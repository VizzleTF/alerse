diff --git a/chrome/browser/ui/browser_live_tab_context.cc b/chrome/browser/ui/browser_live_tab_context.cc
index 93bbb97..5f3897c 100644
--- a/chrome/browser/ui/browser_live_tab_context.cc
+++ b/chrome/browser/ui/browser_live_tab_context.cc
@@ -208,6 +208,12 @@ std::map<std::string, std::string> BrowserLiveTabContext::GetExtraDataForTab(
       !pinned.empty()) {
     extra_data[alerse::kPinnedTabExtraDataKey] = pinned;
   }
+  // Alerse: a reopened tab (Ctrl+Shift+T) comes back in its Space's storage
+  // partition, with the Space's logins.
+  if (std::optional<std::string> space = alerse::GetSpaceOfContents(
+          tab_strip_model_->GetWebContentsAt(index))) {
+    extra_data[alerse::kSpaceTabExtraDataKey] = *space;
+  }
 
   return extra_data;
 }
diff --git a/content/browser/preloading/prerender/prerender_host.cc b/content/browser/preloading/prerender/prerender_host.cc
index f877c9a..302c27e 100644
--- a/content/browser/preloading/prerender/prerender_host.cc
+++ b/content/browser/preloading/prerender/prerender_host.cc
@@ -527,6 +527,16 @@ PrerenderHost::PrerenderHost(
             ? SiteInstanceImpl::CreateForURL(web_contents.GetBrowserContext(),
                                              attributes.prerendering_url)
             : SiteInstanceImpl::Create(web_contents.GetBrowserContext());
+    // Alerse: a page prerendered for a Space's tab loads in the Space's
+    // storage partition, or the tab would leave it once the page is shown.
+    if (SiteInstanceImpl* primary =
+            web_contents.GetPrimaryMainFrame()->GetSiteInstance();
+        primary->IsFixedStoragePartition() &&
+        !primary->GetSecurityPrincipal().IsGuest()) {
+      site_instance = SiteInstanceImpl::CreateForFixedStoragePartition(
+          web_contents.GetBrowserContext(), attributes.prerendering_url,
+          primary->GetSecurityPrincipal().GetStoragePartitionConfig());
+    }
 
     if (ShouldAllowProcessReuse() &&
         attributes.initiator_frame_token.has_value()) {
diff --git a/content/browser/web_contents/web_contents_impl.cc b/content/browser/web_contents/web_contents_impl.cc
index 04736ad..4346b66 100644
--- a/content/browser/web_contents/web_contents_impl.cc
+++ b/content/browser/web_contents/web_contents_impl.cc
@@ -5825,6 +5825,14 @@ FrameTree* WebContentsImpl::CreateNewWindow(
       // as long as they preserve the guest's StoragePartition.
       site_instance =
           SiteInstance::CreateForGuest(GetBrowserContext(), partition_config);
+    } else if (source_site_instance->IsFixedStoragePartition() &&
+               !partition_config.is_default()) {
+      // Alerse: a Space's tab is no guest, but its noopener windows (every
+      // target=_blank link, a site's "Sign in" in a new tab) stay in the
+      // Space's storage partition as well, or they open with the logins of
+      // the default one.
+      site_instance = SiteInstance::CreateForFixedStoragePartition(
+          GetBrowserContext(), GURL(url::kAboutBlankURL), partition_config);
     } else {
       site_instance = SiteInstance::Create(GetBrowserContext());
     }
