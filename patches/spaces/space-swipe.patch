+bool VerticalTabStripFocusSwipeController::TrackArcomiumSwipe() {
+  ArcomiumSpaceSwitcher* switcher = FindSpaceSwitcher(region_view_);
+  ArcomiumSidebarView* sidebar = FindSidebar(region_view_);
+  if (!switcher || !sidebar) {
+    return false;
+  }
+  bool forward = cumulative_x_ < 0;
+  if (base::i18n::IsRTL()) {
+    forward = !forward;
+  }
+  arcomium_tracking_ = true;
+  sidebar->TrackSpaceSwipe(cumulative_x_, switcher->CanRotateSpace(forward));
+#if !BUILDFLAG(IS_MAC)
+  // Wheel events say nothing of the fingers lifting: a pause ends the swipe.
+  arcomium_end_timer_.Start(
+      FROM_HERE, base::Milliseconds(160),
+      base::BindOnce(&VerticalTabStripFocusSwipeController::ResetGesture,
+                     base::Unretained(this)));
+#endif
+  return true;
+}
+
+void VerticalTabStripFocusSwipeController::FinishArcomiumSwipe() {
+  if (!arcomium_tracking_) {
+    return;
+  }
+  arcomium_tracking_ = false;
+  arcomium_end_timer_.Stop();
+  ArcomiumSpaceSwitcher* switcher = FindSpaceSwitcher(region_view_);
+  ArcomiumSidebarView* sidebar = FindSidebar(region_view_);
+  if (!sidebar) {
+    return;
+  }
+  bool forward = cumulative_x_ < 0;
+  if (base::i18n::IsRTL()) {
+    forward = !forward;
+  }
+  const bool commit = switcher && switcher->CanRotateSpace(forward) &&
+                      std::abs(cumulative_x_) >= kArcomiumCommitDistance;
+  sidebar->EndSpaceSwipe(
+      commit, forward,
+      base::BindOnce(
+          [](std::unique_ptr<views::ViewTracker> switcher, bool forward) {
+            if (auto* view =
+                    views::AsViewClass<ArcomiumSpaceSwitcher>(switcher->view())) {
+              view->RotateSpace(forward);
+            }
+          },
+          std::make_unique<views::ViewTracker>(switcher), forward));
+}
+
 void VerticalTabStripFocusSwipeController::ResetGesture() {
+  FinishArcomiumSwipe();
   gesture_state_ = GestureState::kNone;
   cumulative_x_ = 0.0f;
   cumulative_y_ = 0.0f;
   has_triggered_in_current_gesture_ = false;
 }
 
+namespace {
+
+ArcomiumSpaceSwitcher* FindSpaceSwitcher(views::View* view) {
+  if (auto* switcher = views::AsViewClass<ArcomiumSpaceSwitcher>(view)) {
+    return switcher;
+  }
+  for (views::View* child : view->children()) {
+    if (ArcomiumSpaceSwitcher* switcher = FindSpaceSwitcher(child)) {
+      return switcher;
+    }
+  }
+  return nullptr;
+}
+
+ArcomiumSidebarView* FindSidebar(views::View* view) {
+  if (auto* sidebar = views::AsViewClass<ArcomiumSidebarView>(view)) {
+    return sidebar;
+  }
+  for (views::View* child : view->children()) {
+    if (ArcomiumSidebarView* sidebar = FindSidebar(child)) {
+      return sidebar;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
 void VerticalTabStripFocusSwipeController::RotateTabGroupFocus(bool forward) {
   if (!region_view_ || !region_view_->tab_strip_model()) {
     return;
   }
+  // Arcomium: through the Spaces as the switcher shows them, closed ones
+  // included, which have no tab group to rotate to until they open.
+  if (ArcomiumSpaceSwitcher* switcher = FindSpaceSwitcher(region_view_)) {
+    ArcomiumSidebarView* sidebar = FindSidebar(region_view_);
+    if (sidebar) {
+      sidebar->PrepareSpaceSlide(forward);
+    }
+    if (!switcher->RotateSpace(forward) && sidebar) {
+      sidebar->CancelSpaceSlide();
+    }
+    return;
+  }
 
   region_view_->tab_strip_model()->RotateFocusedGroup(forward);
 }
