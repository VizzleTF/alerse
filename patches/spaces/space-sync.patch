+void ArcomiumSpaceSwitcher::OpenSavedSpace(const base::Uuid& sync_id) {
+  if (!sync_service_) {
+    return;
+  }
+  std::optional<tab_groups::TabGroupId> group = sync_service_->OpenTabGroup(
