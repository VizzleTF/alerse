+// Alerse: the Space a saved tab group syncs, read from the bookmark folder
+// of the Space ("arcomium.group" holds the saved group's id), or "" for none.
+std::string GetSpaceOfSavedGroup(Profile* profile, const base::Uuid& sync_id) {
+  bookmarks::BookmarkModel* bookmarks =
+      BookmarkModelFactory::GetForBrowserContext(profile);
+  if (!bookmarks || !bookmarks->loaded()) {
+    return std::string();
+  }
+  const std::string id = sync_id.AsLowercaseString();
+  for (const auto& folder : bookmarks->other_node()->children()) {
+    std::string group;
+    std::string space;
+    if (folder->is_folder() &&
+        folder->GetMetaInfo("arcomium.group", &group) && group == id &&
+        folder->GetMetaInfo("arcomium.space", &space) &&
+        !space.starts_with("arc:")) {
+      return space;
+    }
+  }
+  return std::string();
+}
+
+// Alerse: opens a tab of a saved Space in the Space's storage partition, so
+// it keeps the Space's cookies. A page that cannot live there (the New Tab
+// page, an unsynced URL) opens as about:blank in it: a tab never changes its
+// partition, and the other device navigates it later.
+tabs::TabInterface* MaybeOpenTabInSpace(const SavedTabGroupTab& saved_tab,
+                                        BrowserWindowInterface* browser,
+                                        const std::string& space) {
+  if (space.empty()) {
+    return MaybeOpenTabFromSavedTab(saved_tab, browser);
+  }
+  const GURL url = saved_tab.url().SchemeIsHTTPOrHTTPS()
+                       ? saved_tab.url()
+                       : GURL(url::kAboutBlankURL);
+  scoped_refptr<content::SiteInstance> site_instance =
+      alerse::CreateSpaceSiteInstance(browser->GetProfile(), url, space);
+  if (!site_instance) {
+    return MaybeOpenTabFromSavedTab(saved_tab, browser);
+  }
+  content::WebContents::CreateParams create_params(browser->GetProfile(),
+                                                   site_instance);
+  create_params.initially_hidden = true;
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(create_params);
+  content::WebContents* const raw_contents = contents.get();
+  contents->GetController().LoadURL(url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_AUTO_BOOKMARK,
+                                    std::string());
+  browser->GetTabStripModel()->AddWebContents(
+      std::move(contents), -1, ui::PAGE_TRANSITION_AUTO_BOOKMARK,
+      AddTabTypes::ADD_NONE);
+  return browser->GetTabStripModel()->GetTabForWebContents(raw_contents);
+}
+
