diff --git a/content/browser/renderer_host/render_widget_host_view_base.cc b/content/browser/renderer_host/render_widget_host_view_base.cc
index a705de6..e48fbcb 100644
--- a/content/browser/renderer_host/render_widget_host_view_base.cc
+++ b/content/browser/renderer_host/render_widget_host_view_base.cc
@@ -438,11 +438,18 @@ void RenderWidgetHostViewBase::CopyBackgroundColorIfPresentFrom(
       default_background_color_ == other_base.default_background_color_) {
     return;
   }
-  bool was_opaque = IsBackgroundColorOpaque();
+  // Alerse: only the embedder's color makes the next page clear, not a page
+  // that drew nothing (an empty Space's clear blank page), or every page that
+  // follows it in the tab keeps no white of its own.
+  auto embedder_opaque = [this] {
+    return !default_background_color_ ||
+           SkColorGetA(*default_background_color_) == SK_AlphaOPAQUE;
+  };
+  bool was_opaque = embedder_opaque();
   content_background_color_ = other_base.content_background_color_;
   default_background_color_ = other_base.default_background_color_;
   UpdateBackgroundColor();
-  bool opaque = IsBackgroundColorOpaque();
+  bool opaque = embedder_opaque();
   if (was_opaque != opaque && host()->owner_delegate()) {
     host()->owner_delegate()->SetBackgroundOpaque(opaque);
   }
