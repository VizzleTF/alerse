+// Marks the hidden New Tab of an empty Space.
+class ArcomiumEmptySpaceMarker
+    : public content::WebContentsUserData<ArcomiumEmptySpaceMarker> {
+ private:
+  explicit ArcomiumEmptySpaceMarker(content::WebContents* contents)
+      : content::WebContentsUserData<ArcomiumEmptySpaceMarker>(*contents) {}
+  friend class content::WebContentsUserData<ArcomiumEmptySpaceMarker>;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ArcomiumEmptySpaceMarker);
+
+}  // namespace
+
+// static
+bool TabStripModel::IsArcomiumEmptySpace(content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  // Once it goes somewhere, it is a tab like any other.
+  const GURL& url = contents->GetVisibleURL();
+  if (!url.is_empty() && !url.IsAboutBlank() &&
+      !(url.SchemeIs(content::kChromeUIScheme) &&
+        (url.host() == chrome::kChromeUINewTabHost ||
+         url.host() == chrome::kChromeUINewTabPageHost))) {
+    return false;
+  }
+  if (ArcomiumEmptySpaceMarker::FromWebContents(contents)) {
+    return true;
+  }
+  // After a restart the mark is gone: a blank page with no history that no
+  // page opened and that is not loading anything is an empty Space's.
+  content::NavigationController& controller = contents->GetController();
+  return (url.is_empty() || url.IsAboutBlank()) && !contents->HasOpener() &&
+         !controller.GetPendingEntry() && controller.GetEntryCount() <= 1;
+}
+
+void TabStripModel::ArcomiumKeepSpaces(
+    base::span<tabs::TabInterface* const> tabs) {
+  // Not while the window closes, nor in app and popup windows.
+  if (tabs.empty() || closing_all_ || !delegate()->IsNormalWindow() ||
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "close-window-with-last-tab") == "always") {
+    return;
+  }
+  std::set<tabs::TabInterface*> leaving(tabs.begin(), tabs.end());
+  std::vector<std::optional<tab_groups::TabGroupId>> spaces;
+  for (tabs::TabInterface* tab : tabs) {
+    if (std::ranges::find(spaces, tab->GetGroup()) == spaces.end()) {
+      spaces.push_back(tab->GetGroup());
+    }
+  }
+  tabs::TabInterface* const active = GetActiveTab();
+  for (const std::optional<tab_groups::TabGroupId>& space : spaces) {
+    bool emptied = true;
+    for (int i = 0; i < count(); ++i) {
+      tabs::TabInterface* tab = GetTabAtIndex(i);
+      if (tab->GetGroup() == space && !leaving.contains(tab)) {
+        emptied = false;
+        break;
+      }
+    }
+    if (!emptied) {
+      continue;
+    }
+    std::set<content::WebContents*> before;
+    for (int i = 0; i < count(); ++i) {
+      before.insert(GetWebContentsAt(i));
+    }
+    // It shows when the Space's last tab was the one shown.
+    const bool foreground =
+        active && leaving.contains(active) && active->GetGroup() == space;
+    // A blank page: Arc shows an empty Space as nothing. Marked before it
+    // shows, so that it does not take the address bar's focus; not plain
+    // about:blank, which content focuses the address bar for at startup.
+    delegate()->AddTabAt(GURL("about:blank#arcomium-space"), -1,
+                         /*foreground=*/false, space);
+    for (int i = 0; i < count(); ++i) {
+      content::WebContents* contents = GetWebContentsAt(i);
+      if (!before.contains(contents)) {
+        ArcomiumEmptySpaceMarker::CreateForWebContents(contents);
+        if (foreground) {
+          ActivateTabAt(i);
+        }
+        break;
+      }
+    }
+  }
+}
