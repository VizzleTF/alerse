+// (explicit or the focused one). --arcomium-space=<id> forces a Space, for
+// testing.
+std::optional<std::string> GetSpaceForNewTab(const NavigateParams& params) {
+  const std::string forced =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "arcomium-space");
+  if (!forced.empty()) {
+    return forced;
+  }
+  if (params.source_contents) {
+    if (std::optional<std::string> space =
+            arcomium::GetSpaceOfContents(params.source_contents)) {
+      return space;
+    }
+  }
+  if (!params.browser ||
+      (params.tabstrip_add_types & AddTabTypes::ADD_PINNED)) {
+    return std::nullopt;
+  }
+  const TabStripModel* model = params.browser->GetTabStripModel();
+  std::optional<tab_groups::TabGroupId> group =
+      params.group ? params.group : model->GetFocusedGroup();
+  return group ? arcomium::GetSpaceOfGroup(model, *group) : std::nullopt;
+}
